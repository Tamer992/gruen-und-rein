---
import { p } from '../pfad';
import Basis from '../layouts/Basis.astro';
import Bild from '../components/Bild.astro';
import Symbol from '../components/Symbol.astro';
import { site } from '../site.config';

// Fotos: Unsplash-Lizenz (freie Nutzung), als Übergang bis zu eigenen Fotos. Quellen in src/bilder/QUELLEN.md
import fotoEinstieg from '../bilder/gespraech-fotoalbum.jpg';
import fotoHaende from '../bilder/haende.jpg';
import fotoAlltag from '../bilder/alltag-arm-in-arm.jpg';
import fotoHaus from '../bilder/hauswirtschaft-kueche.jpg';
import fotoRein from '../bilder/reinigung-kueche-hell.jpg';
import fotoGarten from '../bilder/garten-pflanze.jpg';
import fotoWeg from '../bilder/alltag-spaziergang.jpg';
import fotoTrauer from '../bilder/trauer-blumen.jpg';
---
<Basis
  titel={`Alltagsbegleitung, Hauswirtschaft und Reinigung in ${site.ort} | ${site.name}`}
  beschreibung={`${site.name} in ${site.ort}: Alltagsbegleitung und Betreuung, Trauerbegleitung, Hauswirtschaft, Gebäudereinigung und Gartenpflege. Für Senioren, Familien und Betriebe.`}
>
  <!-- Einstieg -->
  <section class="einstieg" aria-labelledby="einstieg-titel">
    <div class="behaelter einstieg__raster">
      <div class="einstieg__text">
        <h1 id="einstieg-titel"><span class="einstieg__zeile">Alltag. Zuhause.</span> <span class="einstieg__zeile einstieg__zeile--gruen">Sauber. Gepflegt.</span></h1>
        <p class="einleitung">
          Wir begleiten, helfen im Haushalt, reinigen und pflegen den Garten. In {site.ort} und Umgebung.
        </p>
        <div class="einstieg__handeln">
          <a class="knopf knopf--haupt" href={`tel:${site.telefonLink}`}>
            <Symbol name="telefon" kreis />
            Jetzt anrufen
          </a>
          <a class="knopf knopf--neben" href={`https://wa.me/${site.whatsappLink}`}>
            <Symbol name="whatsapp" kreis />
            WhatsApp schreiben
          </a>
        </div>
      </div>
      <Bild
        klasse="einstieg__bild"
        bild={fotoEinstieg}
        format="4-3"
        zuerst
        ausschnitt="rechts"
        sizes="(min-width: 80em) 46rem, (min-width: 64em) 56vw, 100vw"
        alt="Eine Begleiterin und ein älterer Herr schauen lachend gemeinsam in ein Fotoalbum"
      />
    </div>

    <div class="behaelter">
      <ul class="fakten" aria-label="Das ist uns wichtig">
        <li><Symbol name="haken" /> Eine feste Ansprechperson</li>
        {site.pflegekasse && <li><Symbol name="haken" /> Wir regeln alles mit der Pflegekasse</li>}
        <li><Symbol name="haken" /> Für Privat und Gewerbe</li>
      </ul>
    </div>
  </section>

  <!-- Für Sie selbst oder für Ihre Eltern -->
  <section class="bereich zwei-wege" aria-labelledby="zwei-wege-titel">
    <div class="behaelter zwei-wege__raster">
      <Bild
        klasse="zwei-wege__bild"
        bild={fotoHaende}
        format="4-5"
        sizes="(min-width: 64em) 30rem, 100vw"
        alt="Eine jüngere Hand liegt auf der Hand einer älteren Person"
      />
      <div class="zwei-wege__text">
        <h2 id="zwei-wege-titel">Für Sie selbst. Oder für Ihre Eltern.</h2>
        <div class="zwei-wege__weg">
          <h3>Für Sie selbst</h3>
          <p>
            Sie möchten weiter selbstständig zu Hause leben und wünschen sich etwas Unterstützung, beim Einkaufen,
            im Haushalt oder im Garten. Erzählen Sie uns, was Ihnen gut tun würde. Wir kommen vorbei und finden
            gemeinsam den richtigen Weg.
          </p>
        </div>
        <div class="zwei-wege__weg">
          <h3>Für Ihre Mutter oder Ihren Vater</h3>
          <p>
            Sie möchten Ihre Eltern gut versorgt wissen, auch wenn Sie weiter weg wohnen oder tagsüber arbeiten.
            Wir sprechen mit Ihnen und Ihren Eltern und geben Ihnen auf Wunsch nach jedem Besuch kurz Bescheid.
          </p>
        </div>
        <a class="weiter" href="#ablauf">So einfach geht der Start <Symbol name="pfeil" /></a>
      </div>
    </div>
  </section>

  <!-- Leistungen als Fotokacheln -->
  <section class="bereich leistungen" aria-labelledby="leistungen-titel">
    <div class="behaelter">
      <h2 id="leistungen-titel" class="leistungen__titel">Wobei wir Sie unterstützen</h2>

      <div class="kacheln">
        <a class="kachel kachel--alltag" href={p('/alltagsbegleitung/')}>
          <Bild
            klasse="kachel__bild"
            bild={fotoAlltag}
            format="frei"
            ausschnitt="oben"
            sizes="(min-width: 64em) 44rem, 100vw"
            alt="Ein Begleiter geht Arm in Arm mit einer älteren Dame"
          />
          <div class="kachel__text">
            <h3>Alltagsbegleitung <Symbol name="pfeil" /></h3>
            <p>Gesellschaft, Spaziergänge, Einkäufe und Begleitung zum Arzt. So wird der Alltag wieder leichter.</p>
            {site.pflegekasse && <p class="kachel__kasse"><Symbol name="haken" /> Über die Pflegekasse möglich</p>}
          </div>
        </a>

        <a class="kachel kachel--haus" href={p('/hauswirtschaft/')}>
          <Bild
            klasse="kachel__bild"
            bild={fotoHaus}
            format="16-9"
            sizes="(min-width: 64em) 30rem, 100vw"
            alt="Eine ältere Frau bereitet in ihrer Küche einen Salat zu"
          />
          <div class="kachel__text">
            <h3>Hauswirtschaft <Symbol name="pfeil" /></h3>
            <p>Wäsche, Küche, Bad, Einkaufen und alles, was Ihren Haushalt leichter macht.</p>
            {site.pflegekasse && <p class="kachel__kasse"><Symbol name="haken" /> Über die Pflegekasse möglich</p>}
          </div>
        </a>

        <a class="kachel kachel--rein" href={p('/gebaeudereinigung/')}>
          <Bild
            klasse="kachel__bild"
            bild={fotoRein}
            format="16-9"
            sizes="(min-width: 64em) 30rem, 100vw"
            alt="Eine helle, aufgeräumte Küche mit großem Fenster"
          />
          <div class="kachel__text">
            <h3>Gebäudereinigung <Symbol name="pfeil" /></h3>
            <p>Wohnung, Haus, Büro und Treppenhaus. Regelmäßig oder als gründliche Grundreinigung.</p>
          </div>
        </a>

        <a class="kachel kachel--trauer" href={p('/trauerbegleitung/')}>
          <Bild
            klasse="kachel__bild"
            bild={fotoTrauer}
            format="4-3"
            sizes="(min-width: 64em) 30rem, 100vw"
            alt="Blumen im warmen Abendlicht"
          />
          <div class="kachel__text">
            <h3>Trauerbegleitung <Symbol name="pfeil" /></h3>
            <p>Zuhören, Gespräche und Unterstützung im Alltag. Wir begleiten Sie behutsam durch diese Zeit.</p>
            {site.pflegekasse && <p class="kachel__kasse"><Symbol name="haken" /> Über die Pflegekasse möglich</p>}
          </div>
        </a>

        <a class="kachel kachel--garten" href={p('/gartenpflege/')}>
          <Bild
            klasse="kachel__bild"
            bild={fotoGarten}
            format="16-9"
            sizes="(min-width: 64em) 44rem, 100vw"
            alt="Hände in Gartenhandschuhen setzen eine junge Pflanze in die Erde"
          />
          <div class="kachel__text">
            <h3>Gartenpflege <Symbol name="pfeil" /></h3>
            <p>Gepflegter Rasen, schöne Beete und ordentliche Außenanlagen. Laub und Unkraut nehmen wir gleich mit.</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Unterstützung durch die Pflegekasse -->
  {site.pflegekasse && (
    <section class="kasse" aria-labelledby="kasse-titel">
      <div class="behaelter">
        <div class="kasse__flaeche">
          <div class="kasse__text">
            <h2 id="kasse-titel">Wir regeln das mit Ihrer Pflegekasse.</h2>
            <p>
              Mit einem Pflegegrad übernimmt Ihre Pflegekasse Alltagsbegleitung, Hauswirtschaft und
              Trauerbegleitung. Dafür steht Ihnen jeden Monat der Entlastungsbetrag zur Verfügung.
            </p>
            <p>
              Die Abrechnung erledigen wir für Sie. Wir stimmen alles mit Ihrer Kranken- und Pflegekasse ab,
              Sie lehnen sich zurück.
            </p>
            <a class="knopf knopf--hell" href={`tel:${site.telefonLink}`}>
              <Symbol name="telefon" kreis />
              Jetzt anrufen
            </a>
          </div>
          <div class="kasse__liste">
            <p class="kasse__ueber">Mit der Pflegekasse möglich</p>
            <ul>
              <li><Symbol name="haken" /> Alltagsbegleitung und Betreuung</li>
              <li><Symbol name="haken" /> Hauswirtschaft</li>
              <li><Symbol name="haken" /> Trauerbegleitung</li>
            </ul>
            <p class="kasse__hinweis">Gebäudereinigung und Gartenpflege vereinbaren wir direkt mit Ihnen.</p>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Ablauf -->
  <section class="bereich ablauf" id="ablauf" aria-labelledby="ablauf-titel">
    <div class="behaelter">
      <h2 id="ablauf-titel">So einfach fängt es an</h2>
      <ol class="schritte">
        <li>
          <span class="schritte__zahl" aria-hidden="true">1</span>
          <h3>Anrufen</h3>
          <p>Sie erzählen uns, was Sie sich wünschen. Wir beantworten Ihre Fragen in aller Ruhe.</p>
        </li>
        <li>
          <span class="schritte__zahl" aria-hidden="true">2</span>
          <h3>Kennenlernen</h3>
          <p>Wir besuchen Sie zu Hause, gern gemeinsam mit Ihren Angehörigen. Sie erhalten ein klares Angebot.</p>
        </li>
        <li>
          <span class="schritte__zahl" aria-hidden="true">3</span>
          <h3>Loslegen</h3>
          <p>Wir vereinbaren feste Tage und Zeiten. Ihre Ansprechperson kennt Sie und Ihre Wünsche.</p>
        </li>
      </ol>

      <div class="angebot">
        <h3>Ihr persönliches Angebot</h3>
        <p>
          Wir stellen Ihr Angebot so zusammen, wie es zu Ihnen passt: was Sie sich wünschen und wie oft wir kommen.
          Beim ersten Besuch erhalten Sie einen festen, fairen Preis und entscheiden ganz in Ruhe.
        </p>
        {site.pflegekasse && (
          <p>
            Mit Pflegegrad regeln wir Alltagsbegleitung, Hauswirtschaft und Trauerbegleitung direkt mit Ihrer Pflegekasse.
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- Wer zu Ihnen kommt -->
  <section class="bereich vorstellung" aria-labelledby="vorstellung-titel">
    <div class="behaelter vorstellung__raster">
      <div class="vorstellung__text">
        <h2 id="vorstellung-titel">Jemand, der Zeit mitbringt.</h2>
        <p>
          Hinter {site.name} {site.mehrereInhaber ? 'stehen' : 'steht'} {site.inhaberin}. Bei uns haben Sie eine feste Ansprechperson,
          die Sie kennt, pünktlich kommt und gern zuhört.
        </p>
        <a class="weiter" href={p('/ueber-uns/')}>Mehr über uns <Symbol name="pfeil" /></a>
      </div>
      <Bild
        klasse="vorstellung__bild"
        bild={fotoWeg}
        format="16-9"
        sizes="(min-width: 64em) 46rem, 100vw"
        alt="Eine Begleiterin geht mit einer älteren Dame mit Gehstock die Straße entlang"
      />
    </div>
  </section>
</Basis>

<style>
  /* Einstieg */
  .einstieg {
    padding-top: var(--a-3);
  }
  .einstieg__raster {
    display: grid;
    gap: var(--a-4);
  }
  .einstieg h1 {
    margin-bottom: var(--a-3);
  }
  .einstieg h1 {
    font-size: clamp(2.2rem, 1.3rem + 3.1vw, 4rem);
  }
  .einstieg__zeile {
    display: block;
    white-space: nowrap;
  }
  .einstieg__zeile--gruen {
    color: var(--waldgruen);
  }
  .einstieg .einleitung {
    max-width: 30ch;
  }
  .einstieg__handeln {
    display: flex;
    flex-wrap: wrap;
    gap: var(--a-2);
    margin-top: var(--a-4);
  }
  .einstieg :global(.einstieg__bild) {
    order: -1;
  }
  @media (max-width: 29.99em) {
    .einstieg__handeln .knopf {
      flex: 1 1 100%;
    }
  }
  @media (min-width: 64em) {
    .einstieg {
      padding-top: var(--a-5);
    }
    .einstieg__raster {
      grid-template-columns: minmax(0, 11fr) minmax(0, 13fr);
      align-items: center;
      gap: var(--a-5);
    }
    .einstieg :global(.einstieg__bild) {
      order: 0;
    }
    .einstieg :global(.einstieg__bild .bild__rahmen) {
      border-radius: var(--r-gross);
    }
  }

  .fakten {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--a-2) var(--a-5);
    margin: var(--a-5) 0 0;
    padding: var(--a-3) 0 0;
    border-top: 1px solid var(--linie);
    font-weight: 700;
    max-width: none;
  }
  .fakten li {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .fakten :global(.symbol) {
    width: 1.6rem;
    height: 1.6rem;
    padding: 0.3rem;
    border-radius: 50%;
    background: var(--salbei);
    color: var(--waldgruen);
  }

  /* Zwei Wege */
  .zwei-wege {
    background: var(--salbei);
    margin-top: var(--a-5);
  }
  .zwei-wege__raster {
    display: grid;
    gap: var(--a-5);
  }
  @media (max-width: 63.99em) {
    .zwei-wege :global(.zwei-wege__bild .bild__rahmen) {
      aspect-ratio: 4 / 3;
    }
  }
  .zwei-wege__weg {
    padding-block: var(--a-3);
    border-top: 1px solid var(--linie);
  }
  .zwei-wege__weg:first-of-type {
    border-top: 0;
    padding-top: var(--a-1);
  }
  .zwei-wege__weg h3 {
    margin-bottom: var(--a-1);
  }
  .zwei-wege__weg p {
    margin: 0;
  }
  @media (min-width: 64em) {
    .zwei-wege__raster {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: center;
      gap: var(--a-6);
    }
    .zwei-wege__text h2 {
      margin-bottom: var(--a-4);
    }
  }

  /* Leistungen */
  .leistungen__titel {
    margin-bottom: var(--a-5);
  }
  .kacheln {
    display: grid;
    gap: var(--spalt);
  }
  .kachel {
    display: flex;
    flex-direction: column;
    border-radius: var(--r-bild);
    background: var(--flaeche);
    color: var(--tinte);
    text-decoration: none;
    overflow: hidden;
    box-shadow: 0 1px 2px rgb(18 41 29 / 0.06), 0 8px 24px -12px rgb(18 41 29 / 0.14);
    transition: transform var(--uebergang), box-shadow var(--uebergang);
  }
  .kachel:hover {
    color: var(--tinte);
    transform: translateY(-3px);
    box-shadow: 0 2px 4px rgb(18 41 29 / 0.06), 0 18px 36px -16px rgb(18 41 29 / 0.24);
  }
  .kachel:focus-visible {
    outline-offset: 4px;
  }
  .kachel :global(.kachel__bild) {
    flex: 1 1 auto;
  }
  .kachel :global(.bild__rahmen) {
    border-radius: 0;
  }
  .kachel :global(.bild__rahmen img) {
    transition: transform 600ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .kachel:hover :global(.bild__rahmen img) {
    transform: scale(1.04);
  }
  .kachel__text {
    padding: var(--a-3) var(--a-4) var(--a-4);
  }
  .kachel__text h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: var(--a-1);
  }
  .kachel__text h3 :global(.symbol) {
    width: 0.85em;
    height: 0.85em;
    color: var(--waldgruen);
    transition: transform var(--uebergang);
  }
  .kachel:hover .kachel__text h3 :global(.symbol) {
    transform: translateX(4px);
  }
  .kachel__text p {
    margin: 0;
    color: var(--leise);
  }
  .kachel--alltag .kachel__text h3 {
    font-size: var(--titel-2);
  }
  .kachel--alltag :global(.bild__rahmen) {
    aspect-ratio: 4 / 3;
  }

  @media (min-width: 48em) {
    .kacheln {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .kachel--alltag {
      grid-column: 1 / span 7;
      grid-row: 1 / span 2;
    }
    .kachel--alltag :global(.kachel__bild) {
      position: relative;
      min-height: 20rem;
    }
    .kachel--alltag :global(.bild__rahmen) {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
    }
    .kachel--haus,
    .kachel--rein {
      grid-column: 8 / span 5;
    }
    .kachel--trauer {
      grid-column: 1 / span 5;
    }
    .kachel--garten {
      grid-column: 6 / span 7;
    }
  }

  /* Abrechnung */
  .kasse__flaeche {
    display: grid;
    gap: var(--a-5);
    padding: clamp(2rem, 1rem + 4vw, 4.5rem);
    border-radius: var(--r-gross);
    background: var(--waldgruen);
    color: #e3ece6;
  }
  .kasse h2 {
    color: #fff;
    max-width: 16ch;
    margin-bottom: var(--a-3);
  }
  .kasse__text p {
    font-size: var(--text-gross);
    line-height: 1.5;
  }
  .kasse__text .knopf {
    margin-top: var(--a-2);
  }
  .kasse :focus-visible {
    outline-color: #fff;
  }
  .kasse__liste {
    align-self: center;
    padding: var(--a-4);
    border-radius: var(--r-bild);
    background: rgb(255 255 255 / 0.08);
  }
  .kasse__ueber {
    margin-bottom: var(--a-2);
    font-weight: 700;
    color: var(--blatt);
  }
  .kasse__liste ul {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--a-3);
  }
  .kasse__liste li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.7rem;
    font-family: var(--schrift-titel);
    font-size: var(--titel-3);
    font-weight: 700;
    color: #fff;
  }
  .kasse__liste li + li {
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }
  .kasse__liste :global(.symbol) {
    width: 1.9rem;
    height: 1.9rem;
    padding: 0.4rem;
    border-radius: 50%;
    background: var(--blatt);
    color: var(--tanne);
  }
  .kasse__hinweis {
    margin: 0;
    font-size: var(--text-klein);
  }
  @media (min-width: 64em) {
    .kasse__flaeche {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--a-6);
    }
  }

  .kachel__kasse {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--a-2) !important;
    font-size: var(--text-klein);
    font-weight: 700;
    color: var(--waldgruen) !important;
  }
  .kachel__kasse :global(.symbol) {
    width: 1.35rem;
    height: 1.35rem;
    padding: 0.25rem;
    border-radius: 50%;
    background: var(--salbei);
  }

  /* Ablauf */
  .ablauf {
    padding-top: var(--a-bereich);
  }
  .ablauf h2 {
    margin-bottom: var(--a-5);
  }
  .schritte {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: none;
    display: grid;
    gap: var(--a-4);
  }
  .schritte li {
    position: relative;
  }
  .schritte__zahl {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: var(--a-3);
    border-radius: 50%;
    background: var(--waldgruen);
    color: #fff;
    font-family: var(--schrift-titel);
    font-size: 1.5rem;
    font-weight: 800;
  }
  .schritte h3 {
    margin-bottom: var(--a-1);
  }
  .schritte p {
    margin: 0;
    color: var(--leise);
  }
  @media (min-width: 48em) {
    .schritte {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--spalt);
    }
    .schritte li:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 1.75rem;
      left: 4.5rem;
      right: calc(-1 * var(--spalt) + 1rem);
      height: 2px;
      background: var(--linie);
    }
  }

  .angebot {
    margin-top: var(--a-5);
    padding: var(--a-4);
    border-radius: var(--r-bild);
    background: var(--salbei);
    max-width: 52rem;
  }
  .angebot p:last-child {
    margin-bottom: 0;
  }

  /* Vorstellung */
  .vorstellung {
    padding-top: 0;
  }
  .vorstellung__raster {
    display: grid;
    gap: var(--a-4);
  }
  .vorstellung__text p {
    font-size: var(--text-gross);
    line-height: 1.5;
  }
  @media (min-width: 64em) {
    .vorstellung__raster {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: center;
      gap: var(--a-6);
    }
  }

</style>
