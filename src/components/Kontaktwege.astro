---
// Kontaktwege im Einstieg der Startseite und im Kopf der Unterseiten.
// Mit Finger (Handy, Tablet): zwei Knöpfe zum Anrufen und für WhatsApp.
// Am Computer mit Maus: die Nummer groß zum Abschreiben, daneben zwei QR-Codes zum Scannen mit dem Handy
// (Anrufen und WhatsApp), weil man am Computer meist nicht telefonieren kann (Tamer, 04.10.2026).
import { site } from '../site.config';
import Symbol from './Symbol.astro';
import QrCode from './QrCode.astro';
---
<div class="kontaktwege">
  <div class="kontaktwege__finger">
    <a class="knopf knopf--haupt" href={`tel:${site.telefonLink}`}>
      <Symbol name="telefon" kreis />
      Jetzt anrufen
    </a>
    <a class="knopf knopf--neben" href={`https://wa.me/${site.whatsappLink}`}>
      <Symbol name="whatsapp" kreis />
      WhatsApp schreiben
    </a>
  </div>

  <div class="kontaktwege__maus">
    <div class="kontaktwege__telefon">
      <span class="kontaktwege__art">Rufen Sie uns an</span>
      <a class="kontaktwege__nummer nummer" href={`tel:${site.telefonLink}`}>{site.telefon}</a>
      <span class="kontaktwege__zeit">{site.erreichbarkeit}</span>
    </div>
    <div class="kontaktwege__codes">
      <figure class="kontaktwege__code">
        <QrCode inhalt={`tel:${site.telefonLink}`} beschriftung={`QR-Code: ${site.telefon} anrufen`} />
        <figcaption>Anrufen</figcaption>
      </figure>
      <a class="kontaktwege__code" href={`https://wa.me/${site.whatsappLink}`}>
        <QrCode inhalt={`https://wa.me/${site.whatsappLink}`} beschriftung="QR-Code: WhatsApp-Nachricht schreiben" />
        <span>WhatsApp</span>
      </a>
      <p class="kontaktwege__hinweis">Mit der Handykamera scannen</p>
    </div>
  </div>
</div>

<style>
  .kontaktwege__finger {
    display: flex;
    flex-wrap: wrap;
    gap: var(--a-2);
  }
  .kontaktwege__maus {
    display: none;
  }
  @media (min-width: 48em) and (max-width: 63.99em) {
    .kontaktwege__finger .knopf {
      flex: 1 1 100%;
    }
  }

  /* Computer und Laptop: Maus oder Touchpad als Zeiger */
  @media (hover: hover) and (pointer: fine) {
    .kontaktwege__finger {
      display: none;
    }
    .kontaktwege__maus {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--a-3) var(--a-5);
    }
  }

  .kontaktwege__telefon {
    display: grid;
    gap: 0.15rem;
  }
  .kontaktwege__art {
    font-weight: 700;
    color: var(--tinte);
  }
  .kontaktwege__nummer {
    font-size: clamp(1.9rem, 1.4rem + 1.2vw, 2.5rem);
    line-height: 1.15;
    color: var(--waldgruen);
    text-decoration: none;
  }
  .kontaktwege__nummer:hover {
    color: var(--waldgruen-tief);
  }
  .kontaktwege__zeit {
    color: var(--leise);
  }

  .kontaktwege__codes {
    display: grid;
    grid-template-columns: repeat(2, 6.5rem);
    column-gap: var(--a-2);
    row-gap: 0.4rem;
    padding-left: var(--a-4);
    border-left: 1px solid var(--linie);
  }
  .kontaktwege__code {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    justify-items: center;
    font-size: var(--text-klein);
    font-weight: 700;
    color: var(--tinte);
    text-decoration: none;
  }
  .kontaktwege__code :global(.qr) {
    padding: 0.5rem;
    border-radius: 0.6rem;
    background: var(--papier);
    box-shadow: inset 0 0 0 1px var(--linie);
  }
  a.kontaktwege__code:hover {
    color: var(--waldgruen);
  }
  .kontaktwege__hinweis {
    grid-column: 1 / -1;
    margin: 0;
    font-size: var(--text-klein);
    text-align: center;
    color: var(--leise);
  }
</style>
