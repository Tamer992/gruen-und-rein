---
import { p } from '../pfad';
import { site, leistungen } from '../site.config';
import Symbol from './Symbol.astro';
import logo from './logo-mass.json';

const jahr = new Date().getFullYear();
---
<footer class="fuss">
  <div class="behaelter">
    <div class="fuss__anruf">
      <h2 class="fuss__titel">Rufen Sie uns an. Wir nehmen uns Zeit für Ihre Fragen.</h2>
      <div class="fuss__handeln">
        <a class="knopf knopf--hell" href={`tel:${site.telefonLink}`}>
          <Symbol name="telefon" />
          <span class="nummer">{site.telefon}</span>
        </a>
        <a class="knopf knopf--rahmen" href={`https://wa.me/${site.whatsappLink}`}>
          <Symbol name="whatsapp" />
          WhatsApp schreiben
        </a>
      </div>
      {site.telefon2 && (
        <p class="fuss__zweite">
          Zweite Nummer: <a href={`tel:${site.telefon2Link}`}><span class="nummer">{site.telefon2}</span></a>
        </p>
      )}
      <p class="fuss__zeiten">
        {site.erreichbarkeit}. Wenn niemand abnimmt, rufen wir zurück.
        Lieber schriftlich? <a href={p('/kontakt/#rueckruf')}>Rückruf anfordern</a>
      </p>
    </div>

    <div class="fuss__raster">
      <div class="fuss__betrieb">
        <img src={p('/logo-hell.svg')} alt={site.name} width={logo.breite} height={logo.hoehe} loading="lazy" />
        <address>
          {site.adresse.strasse}<br />
          {site.adresse.plz} {site.adresse.ort}<br />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </address>
      </div>

      <div class="fuss__spalte">
        <h2 class="fuss__ueber">Unterwegs in</h2>
        <ul class="fuss__liste">
          {site.einsatzorte.map((ort) => <li>{ort}</li>)}
        </ul>
      </div>

      <nav class="fuss__spalte" aria-label="Leistungen">
        <h2 class="fuss__ueber">Leistungen</h2>
        <ul class="fuss__liste">
          {leistungen.map((l) => <li><a href={p(l.pfad)}>{l.titel}</a></li>)}
        </ul>
      </nav>

      <nav class="fuss__spalte" aria-label="Über den Betrieb">
        <h2 class="fuss__ueber">Betrieb</h2>
        <ul class="fuss__liste">
          <li><a href={p('/ueber-uns/')}>Über uns</a></li>
          <li><a href={p('/kontakt/')}>Kontakt</a></li>
          <li><a href={p('/impressum/')}>Impressum</a></li>
          <li><a href={p('/datenschutz/')}>Datenschutz</a></li>
        </ul>
      </nav>
    </div>

    <p class="fuss__zeile">© {jahr} {site.name}</p>
  </div>
</footer>

<style>
  .fuss {
    background: var(--tanne);
    color: var(--hell-auf-tanne);
    padding-block: var(--a-6) var(--a-4);
    margin-top: var(--a-bereich);
  }
  .fuss a:not(.knopf) {
    color: #fff;
  }
  .fuss :focus-visible {
    outline-color: #fff;
  }

  .fuss__anruf {
    padding-bottom: var(--a-6);
    border-bottom: 1px solid rgb(255 255 255 / 0.14);
  }
  .fuss__titel {
    color: #fff;
    max-width: 20ch;
    margin-bottom: var(--a-4);
  }
  .fuss__handeln {
    display: flex;
    flex-wrap: wrap;
    gap: var(--a-2);
    margin-bottom: var(--a-3);
  }
  .fuss__handeln .knopf {
    font-size: var(--text-gross);
    min-height: 4rem;
  }
  .fuss__zeiten {
    margin: 0;
  }

  .fuss__raster {
    display: grid;
    gap: var(--a-5) var(--spalt);
    padding-top: var(--a-5);
  }
  .fuss__betrieb img {
    height: 3rem;
    width: auto;
    margin-bottom: var(--a-3);
  }
  .fuss address {
    font-style: normal;
  }
  .fuss__ueber {
    font-family: var(--schrift-text);
    font-size: var(--text-klein);
    font-weight: 700;
    letter-spacing: 0;
    color: #fff;
    margin-bottom: var(--a-1);
  }
  .fuss__liste {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .fuss__liste li {
    min-height: 2.75rem;
    display: flex;
    align-items: center;
  }
  .fuss__liste a {
    text-decoration: none;
  }
  .fuss__liste a:hover {
    text-decoration: underline;
  }
  .fuss__zeile {
    margin: var(--a-5) 0 0;
    font-size: var(--text-klein);
  }

  @media (min-width: 40em) {
    .fuss__raster {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64em) {
    .fuss__raster {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }
  }
</style>
