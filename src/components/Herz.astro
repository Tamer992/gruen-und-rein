---
// Das Herz aus dem Logo, nur klein in den Zierlinien (Fuß, Pflegekassen-Abschnitt).
// Sparsam einsetzen: Mehr Herzen wirken kitschig (Tamer, 03.10.2026). Für Aufzählungen den Haken nehmen, für große Linien das Dach.
// Rein dekorativ, für Vorleseprogramme unsichtbar.
interface Props {
  klasse?: string;
}
const { klasse } = Astro.props;

// Derselbe Pfad wie im Logo (scripts/logo.mjs)
const HERZ = 'M24 40L14 30A5.66 5.66 0 0 1 22 22L24 24L26 22A5.66 5.66 0 0 1 34 30Z';
---
<svg class:list={['herz', klasse]} viewBox="12 19 24 22" aria-hidden="true" focusable="false">
  <path d={HERZ} fill="currentColor" />
</svg>

<style is:global>
  .herz {
    display: block;
    flex: none;
  }
</style>
