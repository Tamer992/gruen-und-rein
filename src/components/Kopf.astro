---
import { p } from '../pfad';
import { site, navigation } from '../site.config';
import Symbol from './Symbol.astro';
import logo from './logo-mass.json';

const aktuell = Astro.url.pathname;
---
<a class="sprung" href="#inhalt">Zum Inhalt springen</a>

<!-- Telefonleiste und Kopfzeile bilden zusammen den Kopf der Seite und kleben gemeinsam oben. Der Bereich ist um die Höhe der Leiste nach oben versetzt:
     Beim Scrollen gleitet die Leiste hinaus, die Kopfzeile mit dem Anrufknopf bleibt stehen.
     So wird der Kopf kompakter, ohne dass sich darunter etwas verschiebt. -->
<header class="kopfbereich">
  <div class="leiste">
    <div class="behaelter leiste__innen">
      <a class="leiste__telefon" href={`tel:${site.telefonLink}`}>
        <Symbol name="telefon" />
        <span><span class="leiste__frage">Rufen Sie uns an:</span> <strong class="nummer">{site.telefon}</strong></span>
      </a>
      <span class="leiste__zeiten">
        <Symbol name="uhr" />
        {site.erreichbarkeit}
      </span>
      <a class="leiste__whatsapp" href={`https://wa.me/${site.whatsappLink}`}>
        <Symbol name="whatsapp" />
        WhatsApp schreiben
      </a>
    </div>
  </div>

  <div class="kopf">
    <div class="behaelter kopf__zeile">
      <a class="kopf__marke" href={p('/')}>
        <img src={p('/logo.svg') + '?v=6'} alt={`${site.name}, zur Startseite`} width={logo.breite} height={logo.hoehe} />
      </a>

      <nav id="hauptnavigation" class="hauptnav" aria-label="Hauptnavigation">
        <ul class="hauptnav__liste">
          {navigation.map((punkt) =>
            punkt.unter ? (
              <li class="hauptnav__gruppe">
                <button
                  class="hauptnav__auf"
                  type="button"
                  aria-expanded="false"
                  aria-controls="nav-leistungen"
                  data-aktiv={punkt.unter.some((u) => aktuell === p(u.pfad)) ? '' : undefined}
                >
                  {punkt.titel}
                  <span class="hauptnav__winkel" aria-hidden="true"></span>
                </button>
                <span class="hauptnav__gruppenname">{punkt.titel}</span>
                <ul class="hauptnav__unter" id="nav-leistungen">
                  {punkt.unter.map((u) => (
                    <li>
                      <a href={p(u.pfad)} aria-current={aktuell === p(u.pfad) ? 'page' : undefined}>
                        <span class="hauptnav__untertitel">{u.titel}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={p(punkt.pfad)} aria-current={aktuell.startsWith(p(punkt.pfad)) ? 'page' : undefined}>{punkt.titel}</a>
              </li>
            )
          )}
        </ul>
        <div class="hauptnav__handeln">
          <a class="knopf knopf--haupt" href={`tel:${site.telefonLink}`}>
            <Symbol name="telefon" kreis />
            Jetzt anrufen
          </a>
          <a class="knopf knopf--neben" href={`https://wa.me/${site.whatsappLink}`}>
            <Symbol name="whatsapp" kreis />
            WhatsApp schreiben
          </a>
        </div>
      </nav>

      <a class="knopf knopf--haupt kopf__anruf" href={`tel:${site.telefonLink}`}>
        <Symbol name="telefon" kreis />
        Jetzt anrufen
      </a>

      <button class="kopf__menue" type="button" aria-expanded="false" aria-controls="hauptnavigation">
        <span class="kopf__menue-striche" aria-hidden="true"></span>
        <span class="kopf__menue-wort">Menü</span>
      </button>
    </div>
  </div>
</header>

<style>
  .kopfbereich {
    position: sticky;
    top: calc(-1 * (var(--leiste-hoehe) + var(--kopf-luft)));
    z-index: 40;
  }
  /* Niedrige Fenster (Querformat, starker Zoom): Kopf scrollt normal mit, damit genug Platz für den Inhalt bleibt */
  @media (max-height: 34em) {
    .kopfbereich {
      position: relative;
      top: auto;
    }
  }

  /* Dunkle Leiste mit Telefon: feste Höhe, damit der Versatz oben genau passt */
  .leiste {
    height: var(--leiste-hoehe);
    overflow: hidden;
    background: var(--tanne) var(--korn-hell);
    color: var(--auf-tanne);
    font-size: var(--text-klein);
    white-space: nowrap;
  }
  .leiste__innen {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--a-3);
    height: 100%;
  }
  .leiste a {
    color: var(--hell);
    text-decoration: none;
  }
  .leiste a:hover {
    text-decoration: underline;
    text-decoration-color: var(--messing-hell);
  }
  .leiste :focus-visible {
    outline-color: var(--hell);
    outline-offset: -3px;
    box-shadow: none;
  }
  .leiste__telefon,
  .leiste__zeiten,
  .leiste__whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    height: 100%;
    padding-inline: 0.25rem;
  }
  .leiste__telefon {
    font-size: 1.125rem;
  }
  .leiste :global(.symbol) {
    color: var(--messing-hell);
  }
  .leiste__zeiten,
  .leiste__whatsapp {
    display: none;
  }
  @media (min-width: 48em) {
    .leiste__whatsapp {
      display: inline-flex;
    }
  }
  @media (min-width: 64em) {
    .leiste__zeiten {
      display: inline-flex;
      margin-right: auto;
      padding-left: var(--a-3);
      border-left: 1px solid var(--linie-auf-tanne);
    }
  }
  @media (max-width: 29.99em) {
    .leiste__frage {
      display: none;
    }
  }

  /* Hauptzeile: oben etwas mehr Luft, die beim Scrollen mit der Leiste verschwindet */
  .kopf {
    position: relative;
    background: var(--leinen) var(--korn);
    border-bottom: 1px solid var(--linie);
    padding-top: var(--kopf-luft);
    transition: box-shadow var(--uebergang), border-color var(--uebergang);
  }
  :global(.ist-gescrollt) .kopf {
    border-bottom-color: transparent;
    box-shadow: 0 1px 0 var(--linie-zart), 0 12px 28px -20px rgb(46 38 24 / 0.45);
  }
  /* Auf kleinen Bildschirmen ein Raster: Das Logo darf schmaler werden, der Menü-Knopf bleibt daneben */
  .kopf__zeile {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0 var(--a-2);
    min-height: 4.5rem;
  }
  .kopf__marke {
    display: inline-flex;
    justify-self: start;
    min-width: 0;
    padding-block: 0.75rem;
    border-radius: var(--r-feld);
  }
  .kopf__marke img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 2.85rem; /* mit der Zeile „Zuverlässig · mit Herz · individuell“ */
    transform-origin: left center;
    transition: transform var(--uebergang-lang);
  }
  /* Beim Scrollen wird das Logo etwas kleiner (nur optisch, ohne Verschiebung) */
  :global(.ist-gescrollt) .kopf__marke img {
    transform: scale(0.9);
  }
  .kopf__anruf {
    display: none;
  }

  .kopf__menue {
    grid-column: 2;
    grid-row: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 3rem;
    padding: 0.5rem 1.15rem;
    font: inherit;
    font-weight: 700;
    color: var(--waldgruen);
    background: var(--papier);
    border: 0;
    border-radius: var(--r-knopf);
    box-shadow: inset 0 0 0 1.5px var(--linie-knopf);
    cursor: pointer;
    transition: background-color var(--uebergang), box-shadow var(--uebergang);
  }
  .kopf__menue:hover {
    background: var(--sand);
    box-shadow: inset 0 0 0 1.5px var(--waldgruen);
  }
  .kopf__menue:focus-visible {
    border-radius: var(--r-knopf);
    outline-offset: 4px;
  }
  .kopf__menue-striche,
  .kopf__menue-striche::before,
  .kopf__menue-striche::after {
    display: block;
    width: 1.1rem;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }
  .kopf__menue-striche {
    position: relative;
    transition: background-color var(--uebergang);
  }
  .kopf__menue-striche::before,
  .kopf__menue-striche::after {
    content: '';
    position: absolute;
    left: 0;
    transition: transform var(--uebergang), top var(--uebergang);
  }
  .kopf__menue-striche::before { top: -6px; }
  .kopf__menue-striche::after { top: 6px; }
  .kopf__menue[aria-expanded='true'] .kopf__menue-striche { background: transparent; }
  .kopf__menue[aria-expanded='true'] .kopf__menue-striche::before { top: 0; transform: rotate(45deg); }
  .kopf__menue[aria-expanded='true'] .kopf__menue-striche::after { top: 0; transform: rotate(-45deg); }

  /* Navigation: auf kleinen Bildschirmen aufklappbar unter der Zeile, bei Bedarf in sich scrollbar */
  .hauptnav {
    display: none;
    grid-column: 1 / -1;
    grid-row: 2;
    max-height: calc(100vh - 5.5rem);
    max-height: calc(100dvh - 5.5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.25rem 0.25rem var(--a-4);
    margin-inline: -0.25rem;
  }
  .hauptnav:global(.ist-offen) {
    display: block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hauptnav:global(.ist-offen) {
      animation: menue-auf var(--uebergang-lang) both;
    }
  }
  @keyframes menue-auf {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }
  .hauptnav__liste {
    list-style: none;
    margin: 0 0 var(--a-3);
    padding: 0;
    max-width: none;
    border-top: 1px solid var(--linie);
  }
  .hauptnav__liste li {
    border-bottom: 1px solid var(--linie);
  }
  .hauptnav a:not(.knopf) {
    display: flex;
    align-items: center;
    min-height: 3.75rem;
    font-family: var(--schrift-titel);
    font-size: var(--titel-3);
    font-weight: 450;
    color: var(--tinte);
    text-decoration: none;
  }
  .hauptnav a:not(.knopf):hover,
  .hauptnav a[aria-current='page'] {
    color: var(--waldgruen);
  }
  .hauptnav__handeln {
    display: grid;
    gap: var(--a-2);
  }

  /* Leistungen im Handy-Menü: Gruppenname und darunter die fünf Leistungen, eingerückt an einer Messinglinie */
  .hauptnav__auf {
    display: none;
  }
  .hauptnav__gruppenname {
    display: flex;
    align-items: center;
    min-height: 3.75rem;
    font-family: var(--schrift-titel);
    font-size: var(--titel-3);
    font-weight: 450;
  }
  .hauptnav__unter {
    list-style: none;
    margin: 0 0 var(--a-2);
    padding: 0 0 0 var(--a-3);
    border-left: 1px solid var(--messing);
  }
  .hauptnav__liste .hauptnav__unter li {
    border-bottom: 0;
  }
  .hauptnav .hauptnav__unter a:not(.knopf) {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-height: 3.25rem;
    padding-block: 0.45rem;
    font-family: var(--schrift-text);
    font-size: var(--text);
    font-weight: 700;
    line-height: 1.3;
  }

  /* Ab Tablet: Anrufknopf immer in der Kopfzeile */
  @media (min-width: 48em) {
    .kopf__zeile {
      grid-template-columns: minmax(0, 1fr) auto auto;
    }
    .kopf__anruf {
      display: inline-flex;
      grid-column: 2;
      grid-row: 1;
      min-height: 3.25rem;
      font-size: 1.0625rem;
    }
    .kopf__menue {
      grid-column: 3;
    }
    .hauptnav__handeln {
      display: none;
    }
  }

  /* Ab Desktop: Navigation in einer Zeile neben dem Logo */
  @media (min-width: 64em) {
    .kopf__zeile {
      display: flex;
      justify-content: space-between;
      gap: 0 var(--a-3);
      min-height: 5rem;
    }
    .kopf__marke {
      flex: none;
    }
    .kopf__marke img {
      height: 3rem;
      max-height: none;
    }
    .kopf__menue {
      display: none;
    }
    .hauptnav,
    .hauptnav:global(.ist-offen) {
      display: block;
      max-height: none;
      overflow: visible;
      margin-left: auto;
      padding: 0;
      animation: none;
    }
    .hauptnav__liste {
      display: flex;
      gap: clamp(1rem, 0.1rem + 1.6vw, 2.25rem);
      margin: 0;
      border-top: 0;
    }
    .hauptnav__liste li {
      border-bottom: 0;
    }
    .hauptnav a:not(.knopf) {
      position: relative;
      min-height: 3rem;
      font-family: var(--schrift-text);
      font-size: 1.0625rem;
      font-weight: 700;
      white-space: nowrap;
    }
    .hauptnav a:not(.knopf)::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0.45rem;
      height: 1.5px;
      background: var(--messing);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform var(--uebergang);
    }
    .hauptnav a:not(.knopf):hover::after,
    .hauptnav a[aria-current='page']::after {
      transform: scaleX(1);
    }

    /* Leistungen: Knopf mit Winkel, darunter eine Papierkarte mit den fünf Leistungen.
       Öffnet beim Überfahren mit der Maus und per Klick oder Tastatur (js/seite.js).
       Ohne JavaScript öffnet sie auch, sobald ein Eintrag den Fokus hat. */
    .hauptnav__gruppenname {
      display: none;
    }
    .hauptnav__gruppe {
      position: relative;
    }
    .hauptnav__auf {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 3rem;
      padding: 0;
      font: inherit;
      font-size: 1.0625rem;
      font-weight: 700;
      color: var(--tinte);
      white-space: nowrap;
      background: none;
      border: 0;
      cursor: pointer;
      transition: color var(--uebergang);
    }
    .hauptnav__auf::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0.45rem;
      height: 1.5px;
      background: var(--messing);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform var(--uebergang);
    }
    .hauptnav__auf:hover,
    .hauptnav__auf[aria-expanded='true'],
    .hauptnav__auf[data-aktiv] {
      color: var(--waldgruen);
    }
    .hauptnav__auf:hover::after,
    .hauptnav__auf[aria-expanded='true']::after,
    .hauptnav__auf[data-aktiv]::after {
      transform: scaleX(1);
    }
    .hauptnav__winkel {
      width: 0.45rem;
      height: 0.45rem;
      margin-top: -0.2rem;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      transform: rotate(45deg);
      transition: transform var(--uebergang), margin var(--uebergang);
    }
    .hauptnav__auf[aria-expanded='true'] .hauptnav__winkel {
      margin-top: 0.2rem;
      transform: rotate(-135deg);
    }
    .hauptnav__unter {
      display: none;
      position: absolute;
      z-index: 10;
      top: calc(100% + 0.5rem);
      left: -1.25rem;
      width: 22rem;
      margin: 0;
      padding: 0.6rem;
      border-left: 0;
      border-radius: 18px;
      background: var(--papier);
      box-shadow: inset 0 0 0 1px var(--linie-zart), var(--schatten-4);
    }
    /* Unsichtbare Brücke, damit die Liste beim Weg mit der Maus offen bleibt */
    .hauptnav__unter::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 100%;
      height: 0.75rem;
    }
    .hauptnav__gruppe:hover .hauptnav__unter,
    .hauptnav__gruppe:global(.ist-offen) .hauptnav__unter,
    :global(html:not(.js-menue)) .hauptnav__gruppe:focus-within .hauptnav__unter {
      display: block;
    }
    @media (prefers-reduced-motion: no-preference) {
      .hauptnav__gruppe:hover .hauptnav__unter,
      .hauptnav__gruppe:global(.ist-offen) .hauptnav__unter {
        animation: menue-auf var(--uebergang) both;
      }
    }
    .hauptnav .hauptnav__unter a:not(.knopf) {
      min-height: 3.5rem;
      padding: 0.6rem 1rem;
      border-radius: 12px;
      font-size: 1.125rem;
      white-space: normal;
      transition: background-color var(--uebergang), color var(--uebergang);
    }
    .hauptnav .hauptnav__unter a:not(.knopf)::after {
      display: none;
    }
    .hauptnav .hauptnav__unter a:not(.knopf):hover,
    .hauptnav .hauptnav__unter a[aria-current='page'] {
      background: var(--sand);
    }
    .hauptnav .hauptnav__unter a:focus-visible {
      border-radius: 12px;
      outline-offset: -3px;
      box-shadow: none;
    }
    .kopf__anruf {
      flex: none;
    }
  }
  @media (min-width: 64em) and (max-width: 74.99em) {
    .kopf__marke img {
      height: 2.85rem;
    }
  }
</style>
