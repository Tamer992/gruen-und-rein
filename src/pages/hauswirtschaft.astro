---
import Leistungsseite from '../components/Leistungsseite.astro';
import { site } from '../site.config';
import fotoKopf from '../bilder/hauswirtschaft-kueche.jpg';
import fotoMitte from '../bilder/hauswirtschaft-waesche.jpg';

const fragen = [
  {
    frage: 'Wie oft kommen Sie?',
    antwort:
      'Ganz nach Ihrem Wunsch: jede Woche, alle zwei Wochen oder mehrmals in der Woche. Feste Tage und Uhrzeiten machen wir beim ersten Besuch aus.',
  },
  {
    frage: 'Was ist der Unterschied zur Gebäudereinigung?',
    antwort:
      'Die Hauswirtschaft ist Hilfe im Haushalt für Menschen, die zu Hause leben: putzen, waschen, einkaufen, kochen. Die Gebäudereinigung ist für Wohnungen, Häuser, Büros und Treppenhäuser, ganz unabhängig vom Alter.',
    link: { text: 'Zur Gebäudereinigung', pfad: '/gebaeudereinigung/' },
  },
  {
    frage: 'Kann ich selbst mithelfen?',
    antwort:
      'Natürlich. Viele legen gern die Wäsche mit zusammen oder kochen mit uns. Und wer lieber die Füße hochlegt, darf das genauso.',
  },
  ...(site.pflegekasse
    ? [
        {
          frage: 'Übernimmt die Pflegekasse die Hauswirtschaft?',
          // [ERGÄNZEN: Abrechnung offen, ob Herz & Glanz direkt mit der Pflegekasse abrechnet. Bis zur Klärung neutral formuliert. Frühere Fassung: „… Wir rechnen direkt mit Ihrer Pflegekasse ab.“]
          antwort:
            'Ja. Mit einem Pflegegrad setzen Sie dafür Ihren monatlichen Entlastungsbetrag ein. Wie die Abrechnung läuft, besprechen wir gern mit Ihnen.',
          link: { text: 'So funktioniert es mit der Pflegekasse', pfad: '/pflegekasse/' },
        },
      ]
    : []),
];
---
<Leistungsseite
  anker="hauswirtschaft"
  titel={`Hauswirtschaft und Haushaltshilfe in ${site.ort} | ${site.name}`}
  beschreibung={`Haushaltshilfe für Senioren in ${site.ort} und Umgebung: putzen, waschen, bügeln, kochen, einkaufen und Fenster putzen. Mit Pflegegrad über die Pflegekasse.`}
  ueberschrift="Ein Zuhause, in dem Sie sich wohlfühlen."
  einleitung="Wir putzen, waschen und bügeln, kochen für Sie und bringen den Einkauf mit. Sie behalten den Überblick, wir packen an."
  bild={fotoKopf}
  alt="Eine ältere Frau bereitet in ihrer Küche einen Salat zu"
  aufgabenTitel="Was wir im Haushalt übernehmen"
  aufgaben={[
    { titel: 'Wohnung reinigen', text: 'Staubsaugen, wischen, Staub wischen. Damit es in allen Zimmern frisch und ordentlich ist.' },
    { titel: 'Waschen und Bügeln', text: 'Waschen, aufhängen, bügeln und ordentlich in den Schrank räumen. Auf Wunsch beziehen wir auch die Betten frisch.' },
    { titel: 'Mahlzeiten zubereiten', text: 'Wir kochen für Sie oder gemeinsam mit Ihnen, frisch und so, wie es Ihnen schmeckt. Gern auch etwas für den nächsten Tag.' },
    { titel: 'Küche', text: 'Abwasch, Kühlschrank und Arbeitsflächen. Alles sauber und an seinem Platz.' },
    { titel: 'Bad', text: 'Waschbecken, Dusche, Wanne und Toilette, gründlich sauber und hygienisch.' },
    { titel: 'Fenster und Gardinen', text: 'Wir putzen die Fenster, nehmen die Gardinen ab und hängen sie frisch gewaschen wieder auf. Die Leiter überlassen Sie uns.' },
    { titel: 'Einkaufen', text: 'Wir besorgen, was auf Ihrer Liste steht, und räumen es gleich an seinen Platz.' },
    { titel: 'Kleine Dinge im Haushalt', text: 'Blumen gießen, Müll hinausbringen, Post sortieren. Alles, was im Alltag dazugehört.' },
  ]}
  mitte={{
    titel: 'Ihr Haushalt, Ihre Ordnung.',
    absaetze: [
      'Jeder Haushalt hat seine eigene Ordnung. Wir fragen nach, wo was hingehört, und machen es so, wie Sie es gewohnt sind.',
      'Nach ein paar Besuchen läuft vieles wie von selbst. Ihre Ansprechperson weiß, was Ihnen wichtig ist, und Sie können sich auf feste Tage verlassen.',
    ],
    bild: fotoMitte,
    alt: 'Hände legen frisch gewaschene Wäsche zu ordentlichen Stapeln zusammen',
  }}
  fragen={fragen}
/>
