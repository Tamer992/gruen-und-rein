---
import { p } from '../pfad';
import { site, navigation } from '../site.config';
import Symbol from './Symbol.astro';
import logo from './logo-mass.json';

const aktuell = Astro.url.pathname;
---
<a class="sprung" href="#inhalt">Zum Inhalt springen</a>

<div class="leiste">
  <div class="behaelter leiste__innen">
    <a class="leiste__telefon" href={`tel:${site.telefonLink}`}>
      <Symbol name="telefon" />
      <span><span class="leiste__frage">Rufen Sie uns an:</span> <strong class="nummer">{site.telefon}</strong></span>
    </a>
    <span class="leiste__zeiten">
      <Symbol name="uhr" />
      {site.erreichbarkeit}
    </span>
    <a class="leiste__whatsapp" href={`https://wa.me/${site.whatsappLink}`}>
      <Symbol name="whatsapp" />
      WhatsApp schreiben
    </a>
  </div>
</div>

<header class="kopf">
  <div class="behaelter kopf__zeile">
    <a class="kopf__marke" href={p('/')}>
      <img src={p('/logo.svg')} alt={`${site.name}, zur Startseite`} width={logo.breite} height={logo.hoehe} />
    </a>

    <nav id="hauptnavigation" class="hauptnav" aria-label="Hauptnavigation">
      <ul class="hauptnav__liste">
        {navigation.map((punkt) => (
          <li>
            <a href={p(punkt.pfad)} aria-current={aktuell.startsWith(p(punkt.pfad)) ? 'page' : undefined}>{punkt.titel}</a>
          </li>
        ))}
      </ul>
      <div class="hauptnav__handeln">
        <a class="knopf knopf--haupt" href={`tel:${site.telefonLink}`}>
          <Symbol name="telefon" kreis />
          Jetzt anrufen
        </a>
        <a class="knopf knopf--neben" href={`https://wa.me/${site.whatsappLink}`}>
          <Symbol name="whatsapp" kreis />
          WhatsApp schreiben
        </a>
      </div>
    </nav>

    <a class="knopf knopf--haupt kopf__anruf" href={`tel:${site.telefonLink}`}>
      <Symbol name="telefon" kreis />
      Jetzt anrufen
    </a>

    <button class="kopf__menue" type="button" aria-expanded="false" aria-controls="hauptnavigation">
      <span class="kopf__menue-striche" aria-hidden="true"></span>
      <span class="kopf__menue-wort">Menü</span>
    </button>
  </div>
</header>

<style>
  /* Dunkle Leiste mit Telefon */
  .leiste {
    background: var(--tanne);
    color: var(--auf-tanne);
    font-size: var(--text-klein);
  }
  .leiste__innen {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--a-3);
    min-height: 3.25rem;
  }
  .leiste a {
    color: var(--hell);
    text-decoration: none;
  }
  .leiste a:hover {
    text-decoration: underline;
    text-decoration-color: var(--messing-hell);
  }
  .leiste :focus-visible {
    outline-color: var(--hell);
  }
  .leiste__telefon,
  .leiste__zeiten,
  .leiste__whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3rem;
  }
  .leiste__telefon {
    font-size: 1.1875rem;
  }
  .leiste :global(.symbol) {
    color: var(--messing-hell);
  }
  .leiste__zeiten,
  .leiste__whatsapp {
    display: none;
  }
  @media (min-width: 48em) {
    .leiste__whatsapp {
      display: inline-flex;
    }
  }
  @media (min-width: 64em) {
    .leiste__zeiten {
      display: inline-flex;
      margin-right: auto;
      padding-left: var(--a-3);
      border-left: 1px solid var(--linie-auf-tanne);
    }
  }
  @media (max-width: 29.99em) {
    .leiste__frage {
      display: none;
    }
  }

  /* Hauptzeile */
  .kopf {
    background: var(--grund);
    border-bottom: 1px solid var(--linie);
  }
  /* Auf kleinen Bildschirmen ein Raster: Das Logo darf schmaler werden, der Menü-Knopf bleibt daneben */
  .kopf__zeile {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0 var(--a-2);
    min-height: 5rem;
  }
  .kopf__marke {
    display: inline-flex;
    justify-self: start;
    min-width: 0;
    padding-block: 1rem;
    border-radius: var(--r-feld);
  }
  .kopf__marke img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 2.75rem;
  }
  .kopf__anruf {
    display: none;
  }

  .kopf__menue {
    grid-column: 2;
    grid-row: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 3rem;
    padding: 0.5rem 1.15rem;
    font: inherit;
    font-weight: 700;
    color: var(--waldgruen);
    background: var(--flaeche);
    border: 0;
    border-radius: var(--r-knopf);
    box-shadow: inset 0 0 0 1.5px var(--linie-knopf);
    cursor: pointer;
    transition: background-color var(--uebergang), box-shadow var(--uebergang);
  }
  .kopf__menue:hover {
    background: var(--sand);
    box-shadow: inset 0 0 0 1.5px var(--waldgruen);
  }
  .kopf__menue:focus-visible {
    border-radius: var(--r-knopf);
    outline-offset: 4px;
  }
  .kopf__menue-striche,
  .kopf__menue-striche::before,
  .kopf__menue-striche::after {
    display: block;
    width: 1.1rem;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }
  .kopf__menue-striche {
    position: relative;
    transition: background-color var(--uebergang);
  }
  .kopf__menue-striche::before,
  .kopf__menue-striche::after {
    content: '';
    position: absolute;
    left: 0;
    transition: transform var(--uebergang), top var(--uebergang);
  }
  .kopf__menue-striche::before { top: -6px; }
  .kopf__menue-striche::after { top: 6px; }
  .kopf__menue[aria-expanded='true'] .kopf__menue-striche { background: transparent; }
  .kopf__menue[aria-expanded='true'] .kopf__menue-striche::before { top: 0; transform: rotate(45deg); }
  .kopf__menue[aria-expanded='true'] .kopf__menue-striche::after { top: 0; transform: rotate(-45deg); }

  /* Navigation: auf kleinen Bildschirmen aufklappbar unter der Zeile */
  .hauptnav {
    display: none;
    grid-column: 1 / -1;
    grid-row: 2;
    padding-bottom: var(--a-4);
  }
  .hauptnav:global(.ist-offen) {
    display: block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hauptnav:global(.ist-offen) {
      animation: menue-auf var(--uebergang-lang) both;
    }
  }
  @keyframes menue-auf {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }
  .hauptnav__liste {
    list-style: none;
    margin: 0 0 var(--a-3);
    padding: 0;
    max-width: none;
    border-top: 1px solid var(--linie);
  }
  .hauptnav__liste li {
    border-bottom: 1px solid var(--linie);
  }
  .hauptnav a:not(.knopf) {
    display: flex;
    align-items: center;
    min-height: 3.75rem;
    font-family: var(--schrift-titel);
    font-size: var(--titel-3);
    font-weight: 500;
    color: var(--tinte);
    text-decoration: none;
  }
  .hauptnav a:not(.knopf):hover,
  .hauptnav a[aria-current='page'] {
    color: var(--waldgruen);
  }
  .hauptnav__handeln {
    display: grid;
    gap: var(--a-2);
  }

  /* Ab Desktop: Navigation in einer Zeile neben dem Logo */
  @media (min-width: 64em) {
    .kopf__zeile {
      display: flex;
      justify-content: space-between;
      gap: 0 var(--a-3);
      min-height: 5.5rem;
    }
    .kopf__marke {
      flex: none;
    }
    .kopf__marke img {
      height: 2.75rem;
      max-height: none;
    }
    .kopf__menue {
      display: none;
    }
    .hauptnav,
    .hauptnav:global(.ist-offen) {
      display: block;
      margin-left: auto;
      padding-bottom: 0;
      animation: none;
    }
    .hauptnav__handeln {
      display: none;
    }
    .hauptnav__liste {
      display: flex;
      gap: clamp(1rem, 0.1rem + 1.6vw, 2.25rem);
      margin: 0;
      border-top: 0;
    }
    .hauptnav__liste li {
      border-bottom: 0;
    }
    .hauptnav a:not(.knopf) {
      position: relative;
      min-height: 3rem;
      font-family: var(--schrift-text);
      font-size: 1.0625rem;
      font-weight: 700;
      white-space: nowrap;
    }
    .hauptnav a:not(.knopf)::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0.45rem;
      height: 1.5px;
      background: var(--messing);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform var(--uebergang);
    }
    .hauptnav a:not(.knopf):hover::after,
    .hauptnav a[aria-current='page']::after {
      transform: scaleX(1);
    }
    .kopf__anruf {
      display: inline-flex;
      flex: none;
      min-height: 3.25rem;
      font-size: 1.0625rem;
    }
  }
  @media (min-width: 64em) and (max-width: 74.99em) {
    .kopf__marke img {
      height: 2.4rem;
    }
  }
</style>
