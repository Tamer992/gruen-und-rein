---
import { p } from '../pfad';
import { site, leistungen, leistungsPfad } from '../site.config';
import Symbol from './Symbol.astro';
import Ansprechpartner from './Ansprechpartner.astro';
import Dach from './Dach.astro';
import logo from './logo-mass.json';

const jahr = new Date().getFullYear();
// Solange es keine Seiten „Über uns“ und „Kontakt“ gibt, zeigen die Links auf die Startseite
const ueberUns = site.unterseiten ? '/ueber-uns/' : '/#ueber-uns';
const kontakt = site.unterseiten ? '/kontakt/' : '/#kontakt';
---
<footer class="fuss flaeche-tanne" id="kontakt">
  <div class="behaelter">
    <div class="fuss__anruf">
      <div class="fuss__kopf">
        <p class="etikett etikett--hell">Kontakt</p>
        <h2 class="fuss__titel">Rufen Sie uns an. Wir nehmen uns Zeit für Ihre Fragen.</h2>
      </div>
      <div class="fuss__wege">
        <Ansprechpartner hell />
        <p class="fuss__zeiten">
          <Symbol name="uhr" />
          <strong class="fuss__zeit">{site.erreichbarkeit}</strong>
        </p>
        <p class="fuss__zeiten fuss__mail">
          <Symbol name="brief" />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>
    </div>

    <div class="fuss__zier" aria-hidden="true" data-einblenden="zier"><Dach /></div>

    <div class:list={['fuss__raster', { 'fuss__raster--ohne-orte': site.einsatzorte.length === 0 }]}>
      <div class="fuss__betrieb">
        <img src={p('/logo-hell.svg') + '?v=7'} alt={site.name} width={logo.breite} height={logo.hoehe} loading="lazy" />
        <address>
          {site.adresse.strasse}<br />
          {site.adresse.plz} {site.adresse.ort}
        </address>
      </div>

      {site.einsatzorte.length > 0 && (
        <div class="fuss__spalte">
          <h2 class="fuss__ueber">Unterwegs in</h2>
          <ul class="fuss__liste">
            {site.einsatzorte.map((ort) => <li>{ort}</li>)}
          </ul>
        </div>
      )}

      <nav class="fuss__spalte" aria-label="Leistungen">
        <h2 class="fuss__ueber">Leistungen</h2>
        <ul class="fuss__liste">
          {leistungen.map((l) => <li><a href={p(leistungsPfad(l))}>{l.titel}</a></li>)}
        </ul>
      </nav>

      <nav class="fuss__spalte" aria-label="Über den Betrieb">
        <h2 class="fuss__ueber">Betrieb</h2>
        <ul class="fuss__liste">
          <li><a href={p(ueberUns)}>Über uns</a></li>
          {site.pflegekasse && site.unterseiten && <li><a href={p('/pflegekasse/')}>Pflegekasse</a></li>}
          <li><a href={p(kontakt)}>Kontakt</a></li>
          <li><a href={p('/impressum/')}>Impressum</a></li>
          <li><a href={p('/datenschutz/')}>Datenschutz</a></li>
        </ul>
      </nav>
    </div>

    <p class="fuss__zeile">© {jahr} {site.name}</p>
  </div>
</footer>

<style>
  /* Fuß: Tanne mit Papierkorn. Oben die Einladung zum Anruf, darunter ruhig gegliedert die Angaben. */
  .fuss {
    position: relative;
    padding-block: var(--a-bereich) var(--a-4);
  }
  .fuss a:not(.knopf) {
    color: var(--hell);
    text-decoration-color: rgb(252 250 245 / 0.35);
  }
  .fuss a:not(.knopf):hover {
    text-decoration-color: var(--messing-hell);
  }

  .fuss__anruf {
    display: grid;
    gap: var(--a-5);
  }
  .fuss__titel {
    color: var(--hell);
    font-size: var(--titel-2);
    max-width: 17ch;
    margin: 0;
  }





  .fuss__liste {
    display: grid;
    gap: 0.35rem;
    margin: 0;
  }


  /* Zwei Ansprechpartner (Ansprechpartner.astro), darunter Erreichbarkeit und E-Mail */
  .fuss__wege > :global(.partner-rahmen) {
    margin-bottom: var(--a-4);
  }
  .fuss__zeiten.fuss__mail {
    margin-top: var(--a-1);
  }
  .fuss__zeiten {
    display: flex;
    gap: 0.75rem;
    margin: 0;
  }
  .fuss__zeit {
    color: var(--hell);
  }
  .fuss__zeiten > :global(.symbol) {
    margin-top: 0.15em;
    color: var(--messing-hell);
  }

  /* Zierlinie mit dem Dach aus dem Logo, wie auf der Pflegekassen-Fläche */
  .fuss__zier {
    display: flex;
    align-items: center;
    gap: var(--a-3);
    margin-block: var(--a-6) var(--a-5);
    color: var(--messing-hell);
  }
  .fuss__zier::before,
  .fuss__zier::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(214 187 135 / 0.45));
  }
  .fuss__zier::after {
    background: linear-gradient(90deg, rgb(214 187 135 / 0.45), transparent);
  }
  .fuss__zier :global(.dach) {
    width: 1.25rem;
    height: auto;
  }

  .fuss__raster {
    display: grid;
    gap: var(--a-5) var(--spalt);
  }
  .fuss__betrieb img {
    height: 3rem;
    width: auto;
    margin-bottom: var(--a-3);
  }
  .fuss address {
    font-style: normal;
  }
  .fuss__mail a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
  .fuss__zeiten.fuss__mail {
    align-items: center;
  }
  .fuss__ueber {
    font-family: var(--schrift-text);
    font-size: var(--text-klein);
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--messing-hell);
    margin-bottom: var(--a-1);
  }
  .fuss__liste {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .fuss__liste li {
    min-height: 3rem;
    display: flex;
    align-items: center;
  }
  .fuss__liste a {
    display: flex;
    align-items: center;
    min-height: 3rem;
    text-decoration: none;
  }
  .fuss__liste a:hover {
    text-decoration: underline;
  }
  .fuss__zeile {
    max-width: none;
    margin: var(--a-6) 0 0;
    padding-top: var(--a-3);
    border-top: 1px solid var(--linie-auf-tanne);
    font-size: var(--text-klein);
  }

  @media (min-width: 40em) {
    .fuss__raster {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64em) {
    .fuss__anruf {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--spalt);
      align-items: end;
    }
    .fuss__kopf {
      grid-column: 1 / span 7;
    }
    .fuss__wege {
      grid-column: 8 / -1;
    }
    .fuss__raster {
      grid-template-columns: 2fr 1fr 1.4fr 1fr;
    }
    /* Ohne Einsatzorte fehlt die Spalte „Unterwegs in“ */
    .fuss__raster--ohne-orte {
      grid-template-columns: 2fr 1.4fr 1fr;
    }
  }
  /* Platz für die feste Anrufleiste auf dem Handy */
  @media (max-width: 47.99em) and (not ((hover: hover) and (pointer: fine))) {
    .fuss {
      padding-bottom: calc(var(--a-4) + 4.75rem + env(safe-area-inset-bottom));
    }
  }
</style>
