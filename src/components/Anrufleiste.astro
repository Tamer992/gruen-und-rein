---
// Feste Leiste am unteren Rand, nur auf dem Handy: Anrufen und WhatsApp.
// Seit 09.10.2026 zwei Nummern (Hussain, Alireza): beide Knöpfe öffnen eine kleine Auswahl (Anrufwahl.astro).
// Nicht am Computer mit Maus, auch nicht bei starkem Zoom (nur-finger, Tamer 04.10.2026).
// „ruhig“ nimmt die Farbe zurück (für die Trauerbegleitung).
import { site } from '../site.config';
import Symbol from './Symbol.astro';
import Anrufwahl from './Anrufwahl.astro';
const { ruhig = false } = Astro.props;
---
<aside class:list={['anrufleiste', 'nur-finger', { 'anrufleiste--ruhig': ruhig }]} aria-label="Schnellkontakt">
  <Anrufwahl art="anruf" klasse="anrufleiste__knopf anrufleiste__anruf">
    <Symbol name="telefon" />
    Jetzt anrufen
  </Anrufwahl>
  <Anrufwahl art="whatsapp" ausrichtung="rechts" klasse="anrufleiste__knopf anrufleiste__whatsapp">
    <Symbol name="whatsapp" />
    WhatsApp
  </Anrufwahl>
</aside>

<style>
  .anrufleiste {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 50;
    display: grid;
    /* Anrufen bekommt etwas mehr Platz, damit „Jetzt anrufen“ in eine Zeile passt */
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 0.5rem;
    padding: 0.65rem var(--rand) calc(0.65rem + env(safe-area-inset-bottom));
    background: var(--papier) var(--korn);
    border-top: 1px solid var(--linie);
    box-shadow: 0 -10px 30px -18px rgb(46 38 24 / 0.35);
  }
  .anrufleiste :global(.anrufleiste__knopf) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 3.25rem;
    padding-inline: 0.5rem;
    border-radius: var(--r-knopf);
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
  }
  .anrufleiste :global(.anrufleiste__knopf:focus-visible) {
    border-radius: var(--r-knopf);
  }
  .anrufleiste :global(.anrufleiste__anruf) {
    background: var(--waldgruen);
    color: var(--hell);
    box-shadow: var(--schatten-knopf);
  }
  .anrufleiste :global(.anrufleiste__whatsapp) {
    background: var(--flaeche);
    color: var(--waldgruen);
    box-shadow: inset 0 0 0 1.5px var(--linie-knopf);
  }
  .anrufleiste--ruhig :global(.anrufleiste__anruf) {
    background: var(--sand);
    color: var(--waldgruen);
    box-shadow: none;
  }
  /* Sehr schmal (oder stark vergrößert): Symbole weglassen, damit der Text Platz hat */
  @media (max-width: 22.5em) {
    .anrufleiste :global(.symbol) {
      display: none;
    }
  }
  @media (min-width: 48em) {
    .anrufleiste {
      display: none;
    }
  }
</style>
