---
// Text für Anruf-Knöpfe: Auf dem Handy „Jetzt anrufen“, am Computer mit Maus die Nummer selbst,
// weil man dort meist nicht telefonieren kann und die Nummer abschreiben will (Tamer, 04.10.2026).
// Die Umschaltung steht in global.css (.anruftext).
import { site } from '../site.config';
---
<span class="anruftext"><span class="anruftext__wort">Jetzt anrufen</span><span class="anruftext__nummer nummer">{site.telefon}</span></span>
