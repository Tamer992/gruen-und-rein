---
// Feste Leiste am unteren Rand, nur auf dem Handy: Anrufen und WhatsApp.
// „ruhig“ nimmt die Farbe zurück (für die Trauerbegleitung).
import { site } from '../site.config';
import Symbol from './Symbol.astro';
const { ruhig = false } = Astro.props;
---
<div class:list={['anrufleiste', { 'anrufleiste--ruhig': ruhig }]}>
  <a class="anrufleiste__anruf" href={`tel:${site.telefonLink}`}>
    <Symbol name="telefon" kreis />
    Jetzt anrufen
  </a>
  <a class="anrufleiste__whatsapp" href={`https://wa.me/${site.whatsappLink}`}>
    <Symbol name="whatsapp" kreis />
    WhatsApp
  </a>
</div>

<style>
  .anrufleiste {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    padding: 0.6rem var(--rand) calc(0.6rem + env(safe-area-inset-bottom));
    background: var(--grund);
    border-top: 1px solid var(--linie);
  }
  .anrufleiste a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 3.25rem;
    border-radius: var(--r-knopf);
    font-weight: 700;
    text-decoration: none;
  }
  .anrufleiste__anruf {
    background: var(--waldgruen);
    color: #fff;
  }
  .anrufleiste__whatsapp {
    background: var(--salbei);
    color: var(--waldgruen);
  }
  .anrufleiste__anruf :global(.symbol--kreis) {
    background: rgb(255 255 255 / 0.14);
  }
  .anrufleiste__whatsapp :global(.symbol--kreis) {
    background: #fff;
  }
  .anrufleiste--ruhig .anrufleiste__anruf {
    background: var(--salbei);
    color: var(--waldgruen);
  }
  @media (min-width: 48em) {
    .anrufleiste {
      display: none;
    }
  }
</style>
