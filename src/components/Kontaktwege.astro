---
// Kontaktwege im Einstieg der Startseite und im Kopf der Unterseiten.
// Seit 09.10.2026 zwei Inhaber mit eigener Nummer und WhatsApp (Tamer): beide gleichwertig (Ansprechpartner.astro),
// am Computer je ein QR-Code zum Anrufen, mit Finger Nummer und WhatsApp direkt antippen.
// Vorher: ein Knopf „Jetzt anrufen“, ein Knopf „WhatsApp schreiben“ und ein QR-Code für eine Nummer.
import { site } from '../site.config';
import Ansprechpartner from './Ansprechpartner.astro';
---
<div class="kontaktwege">
  <p class="kontaktwege__art">Rufen Sie uns an oder schreiben Sie uns</p>
  <Ansprechpartner />
  <p class="kontaktwege__zeit">{site.erreichbarkeit}</p>
</div>

<style>
  .kontaktwege {
    display: grid;
    gap: var(--a-2);
    width: 100%;
  }
  .kontaktwege__art {
    margin: 0;
    font-weight: 700;
    color: var(--tinte);
  }
  .kontaktwege__zeit {
    margin: 0;
    color: var(--leise);
  }
</style>
