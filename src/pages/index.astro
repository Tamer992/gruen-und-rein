---
import { p } from '../pfad';
import Basis from '../layouts/Basis.astro';
import Bild from '../components/Bild.astro';
import Symbol from '../components/Symbol.astro';
import Blatt from '../components/Blatt.astro';
import { site, leistungen } from '../site.config';

// Fotos: Unsplash-Lizenz (freie Nutzung), als Übergang bis zu eigenen Fotos. Quellen in src/bilder/QUELLEN.md
import fotoEinstieg from '../bilder/gespraech-fotoalbum.jpg';
import fotoHaende from '../bilder/haende.jpg';
import fotoAlltag from '../bilder/alltag-arm-in-arm.jpg';
import fotoHaus from '../bilder/hauswirtschaft-kueche.jpg';
import fotoRein from '../bilder/reinigung-kueche-hell.jpg';
import fotoGarten from '../bilder/garten-pflanze.jpg';
import fotoWeg from '../bilder/alltag-spaziergang.jpg';
import fotoTrauer from '../bilder/trauer-blumen.jpg';

// Leistungen: zuerst die drei, die über die Pflegekasse möglich sind.
// Solange es keine Unterseiten gibt (site.unterseiten), sind die Einträge keine Links.
// Jedes Foto hat sein eigenes Format, damit die Liste nicht wie ein Kachelraster wirkt.
const kacheln = [
  {
    anker: 'alltagsbegleitung',
    titel: 'Alltagsbegleitung',
    text: 'Gesellschaft, Spaziergänge, Einkäufe und Begleitung zum Arzt. So wird der Alltag wieder leichter.',
    kasse: true,
    bild: fotoAlltag,
    format: '4-5' as const,
    ausschnitt: 'oben' as const,
    alt: 'Ein Begleiter geht Arm in Arm mit einer älteren Dame',
  },
  {
    anker: 'hauswirtschaft',
    titel: 'Hauswirtschaft',
    text: 'Wäsche, Küche, Bad, Einkaufen und alles, was Ihren Haushalt leichter macht.',
    kasse: true,
    bild: fotoHaus,
    format: '1-1' as const,
    ausschnitt: 'mitte' as const,
    alt: 'Eine ältere Frau bereitet in ihrer Küche einen Salat zu',
  },
  {
    anker: 'trauerbegleitung',
    titel: 'Trauerbegleitung',
    text: 'Zuhören, Gespräche und Unterstützung im Alltag. Wir begleiten Sie behutsam durch diese Zeit.',
    kasse: true,
    bild: fotoTrauer,
    format: '4-5' as const,
    ausschnitt: 'mitte' as const,
    alt: 'Blumen im warmen Abendlicht',
  },
  {
    anker: 'gebaeudereinigung',
    titel: 'Gebäudereinigung',
    text: 'Wohnung, Haus, Büro und Treppenhaus. Regelmäßig oder als gründliche Grundreinigung.',
    kasse: false,
    bild: fotoRein,
    format: '4-3' as const,
    ausschnitt: 'mitte' as const,
    alt: 'Eine helle, aufgeräumte Küche mit großem Fenster',
  },
  {
    anker: 'gartenpflege',
    titel: 'Gartenpflege',
    text: 'Gepflegter Rasen, schöne Beete und ordentliche Außenanlagen. Laub und Unkraut nehmen wir gleich mit.',
    kasse: false,
    bild: fotoGarten,
    format: '16-9' as const,
    ausschnitt: 'mitte' as const,
    alt: 'Hände in Gartenhandschuhen setzen eine junge Pflanze in die Erde',
  },
].map((k) => ({ ...k, punkte: leistungen.find((l) => l.anker === k.anker)?.punkte ?? [] }));
const Kachel = site.unterseiten ? 'a' : 'article';
// Bildbreiten passend zum Raster: zwei versetzte Spalten (6 und 5 von 12), die letzte Leistung breit
const groessen = [
  '(min-width: 80em) 36rem, (min-width: 64em) 47vw, (min-width: 48em) 47vw, 100vw',
  '(min-width: 80em) 30rem, (min-width: 64em) 39vw, (min-width: 48em) 47vw, 100vw',
  '(min-width: 80em) 30rem, (min-width: 64em) 39vw, (min-width: 48em) 47vw, 100vw',
  '(min-width: 80em) 36rem, (min-width: 64em) 47vw, (min-width: 48em) 47vw, 100vw',
  '(min-width: 80em) 46rem, (min-width: 64em) 56vw, 100vw',
];

---
<Basis
  titel={`Alltagsbegleitung, Hauswirtschaft und Reinigung in ${site.ort} | ${site.name}`}
  beschreibung={`${site.name} in ${site.ort}: Alltagsbegleitung und Betreuung, Trauerbegleitung, Hauswirtschaft, Gebäudereinigung und Gartenpflege. Für Senioren, Familien und Betriebe.`}
>
  <!-- Einstieg -->
  <section class="einstieg" aria-labelledby="einstieg-titel">
    <div class="behaelter einstieg__raster">
      <div class="einstieg__text">
        <p class="etikett">{site.einsatzorte.join(', ')}</p>
        <h1 id="einstieg-titel"><span class="einstieg__zeile">Alltag. Zuhause.</span> <span class="einstieg__zeile einstieg__zeile--gruen">Sauber. Gepflegt.</span></h1>
        <p class="einleitung">
          Wir begleiten, helfen im Haushalt, reinigen und pflegen den Garten. In {site.ort} und Umgebung.
        </p>
        <div class="einstieg__handeln">
          <a class="knopf knopf--haupt" href={`tel:${site.telefonLink}`}>
            <Symbol name="telefon" kreis />
            Jetzt anrufen
          </a>
          <a class="knopf knopf--neben" href={`https://wa.me/${site.whatsappLink}`}>
            <Symbol name="whatsapp" kreis />
            WhatsApp schreiben
          </a>
        </div>
      </div>

      <div class="einstieg__bildbereich">
        <Bild
          klasse="einstieg__bild"
          bild={fotoEinstieg}
          format="4-3"
          formatGross="5-4"
          form="blatt"
          parallaxe
          zuerst
          ausschnitt="rechts"
          sizes="(min-width: 100em) 50rem, (min-width: 64em) 48vw, (min-width: 48em) 46vw, 100vw"
          alt="Eine Begleiterin und ein älterer Herr schauen lachend gemeinsam in ein Fotoalbum"
        />
        {site.pflegekasse && (
          <a class="kassenkarte" href="#pflegekasse">
            <span class="kassenkarte__zeichen"><Blatt /></span>
            <span class="kassenkarte__text">
              <strong>Mit der Pflegekasse möglich</strong>
              <span>Alltagsbegleitung, Hauswirtschaft und Trauerbegleitung</span>
            </span>
            <Symbol name="pfeil" klasse="kassenkarte__pfeil" />
          </a>
        )}
      </div>
    </div>
    <ul class="behaelter fakten" aria-label="Das ist uns wichtig">
      <li><span class="blattpunkt"><Blatt /></span> Eine feste Ansprechperson</li>
      {site.pflegekasse && <li><span class="blattpunkt"><Blatt /></span> Wir regeln alles mit der Pflegekasse</li>}
      <li><span class="blattpunkt"><Blatt /></span> Für Privat und Gewerbe</li>
    </ul>
  </section>

  <!-- Für Sie selbst oder für Ihre Eltern -->
  <section class="bereich zwei-wege flaeche-sand" aria-labelledby="zwei-wege-titel">
    <div class="behaelter zwei-wege__raster">
      <div class="zwei-wege__text">
        <h2 id="zwei-wege-titel" data-einblenden>Für Sie selbst. Oder für Ihre Eltern.</h2>
        <div class="zwei-wege__wege">
          <div class="zwei-wege__weg" data-einblenden>
            <h3>Für Sie selbst</h3>
            <p>
              Sie möchten weiter selbstständig zu Hause leben und wünschen sich etwas Unterstützung, beim Einkaufen,
              im Haushalt oder im Garten. Erzählen Sie uns, was Ihnen gut tun würde. Wir kommen vorbei und finden
              gemeinsam den richtigen Weg.
            </p>
          </div>
          <div class="zwei-wege__weg" data-einblenden="2">
            <h3>Für Ihre Mutter oder Ihren Vater</h3>
            <p>
              Sie möchten Ihre Eltern gut versorgt wissen, auch wenn Sie weiter weg wohnen oder tagsüber arbeiten.
              Wir sprechen mit Ihnen und Ihren Eltern und geben Ihnen auf Wunsch nach jedem Besuch kurz Bescheid.
            </p>
          </div>
        </div>
        <a class="weiter" href="#ablauf"><span>So einfach geht der Start</span> <Symbol name="pfeil" /></a>
      </div>
      <div class="zwei-wege__bildbereich" data-einblenden="2">
        <Bild
          klasse="zwei-wege__bild"
          bild={fotoHaende}
          format="3-2"
          formatGross="4-5"
          form="blatt-gespiegelt"
          parallaxe
          sizes="(min-width: 80em) 33rem, (min-width: 64em) 40vw, 100vw"
          alt="Eine jüngere Hand liegt auf der Hand einer älteren Person"
        />
      </div>
    </div>
  </section>

  <!-- Leistungen: zwei versetzte Spalten mit wechselnden Formaten, die letzte Leistung breit -->
  <section class="bereich leistungen" id="leistungen" aria-labelledby="leistungen-titel">
    <div class="behaelter">
      <div class="bereich__kopf leistungen__kopf" data-einblenden>
        <p class="etikett">Leistungen</p>
        <h2 id="leistungen-titel">Wobei wir Sie unterstützen</h2>
      </div>

      <div class="kacheln">
        {kacheln.map((k, i) => (
          <Kachel
            class:list={['kachel', `kachel--${i + 1}`, { 'kachel--link': site.unterseiten }]}
            id={k.anker}
            href={site.unterseiten ? p(`/${k.anker}/`) : undefined}
          >
            <div class="kachel__innen" data-einblenden={i % 2 ? '2' : ''}>
              <Bild
                klasse="kachel__bild"
                bild={k.bild}
                format={i === 4 ? '4-3' : k.format}
                formatGross={k.format}
                ausschnitt={k.ausschnitt}
                parallaxe
                sizes={groessen[i]}
                alt={k.alt}
              />
              <div class="kachel__text">
                <h3>{k.titel} {site.unterseiten && <Symbol name="pfeil" />}</h3>
                {site.pflegekasse && k.kasse && (
                  <p class="kassenmarke kachel__kasse"><Blatt /> Über die Pflegekasse möglich</p>
                )}
                <p class="kachel__beschreibung">{k.text}</p>
                <ul class="kachel__punkte" aria-label={`${k.titel} im Einzelnen`}>
                  {k.punkte.map((punkt) => <li>{punkt}</li>)}
                </ul>
              </div>
            </div>
          </Kachel>
        ))}
      </div>
    </div>
  </section>

  <!-- Unterstützung durch die Pflegekasse: dunkle Tannenfläche über die ganze Breite -->
  {site.pflegekasse && (
    <section class="kasse flaeche-tanne" id="pflegekasse" aria-labelledby="kasse-titel">
      <div class="behaelter">
        <div class="kasse__zier" aria-hidden="true"><Blatt /></div>
        <div class="kasse__raster">
          <div class="kasse__text" data-einblenden>
            <p class="etikett etikett--hell">Entlastungsbetrag nach <span class="kasse__paragraf">{'§\u00a045b\u00a0SGB\u00a0XI'}</span></p>
            <h2 id="kasse-titel">Wir regeln das mit Ihrer Pflegekasse.</h2>
            <p>
              Mit einem Pflegegrad übernimmt Ihre Pflegekasse Alltagsbegleitung, Hauswirtschaft und
              Trauerbegleitung. Dafür steht Ihnen jeden Monat der Entlastungsbetrag zur Verfügung.
            </p>
            <p>
              Die Abrechnung erledigen wir für Sie. Wir stimmen alles mit Ihrer Kranken- und Pflegekasse ab,
              Sie lehnen sich zurück.
            </p>
            <a class="knopf knopf--hell" href={`tel:${site.telefonLink}`}>
              <Symbol name="telefon" kreis />
              Jetzt anrufen
            </a>
          </div>
          <div class="kasse__liste" data-einblenden="2">
            <p class="kasse__ueber">Mit der Pflegekasse möglich</p>
            <ul>
              <li><span class="kasse__punkt"><Blatt /></span> Alltagsbegleitung und Betreuung</li>
              <li><span class="kasse__punkt"><Blatt /></span> Hauswirtschaft</li>
              <li><span class="kasse__punkt"><Blatt /></span> Trauerbegleitung</li>
            </ul>
            <p class="kasse__hinweis">Gebäudereinigung und Gartenpflege vereinbaren wir direkt mit Ihnen.</p>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Ablauf: links Überschrift und Angebot, rechts drei Schritte mit großen Messing-Ziffern -->
  <section class="bereich ablauf" id="ablauf" aria-labelledby="ablauf-titel">
    <div class="behaelter ablauf__raster">
      <div class="bereich__kopf ablauf__kopf" data-einblenden>
        <p class="etikett">Ablauf</p>
        <h2 id="ablauf-titel">So einfach fängt es an</h2>
      </div>
      <ol class="schritte">
        <li data-einblenden>
          <span class="schritte__zahl" aria-hidden="true">1</span>
          <div>
            <h3>Anrufen</h3>
            <p>Sie erzählen uns, was Sie sich wünschen. Wir beantworten Ihre Fragen in aller Ruhe.</p>
          </div>
        </li>
        <li data-einblenden>
          <span class="schritte__zahl" aria-hidden="true">2</span>
          <div>
            <h3>Kennenlernen</h3>
            <p>Wir besuchen Sie zu Hause, gern gemeinsam mit Ihren Angehörigen. Sie erhalten ein klares Angebot.</p>
          </div>
        </li>
        <li data-einblenden>
          <span class="schritte__zahl" aria-hidden="true">3</span>
          <div>
            <h3>Loslegen</h3>
            <p>Wir vereinbaren feste Tage und Zeiten. Ihre Ansprechperson kennt Sie und Ihre Wünsche.</p>
          </div>
        </li>
      </ol>

      <div class="angebot" data-einblenden>
        <Blatt art="linie" klasse="angebot__blatt" />
        <h3>Ihr persönliches Angebot</h3>
        <p>
          Wir stellen Ihr Angebot so zusammen, wie es zu Ihnen passt: was Sie sich wünschen und wie oft wir kommen.
          Beim ersten Besuch erhalten Sie einen festen, fairen Preis und entscheiden ganz in Ruhe.
        </p>
        {site.pflegekasse && (
          <p>
            Mit Pflegegrad regeln wir Alltagsbegleitung, Hauswirtschaft und Trauerbegleitung direkt mit Ihrer Pflegekasse.
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- Wer zu Ihnen kommt: Sandfläche, Text links, Foto rechts in Blattform ragt nach oben in den Ablauf -->
  <section class="bereich vorstellung flaeche-sand" id="ueber-uns" aria-labelledby="vorstellung-titel">
    <div class="behaelter vorstellung__raster">
      <!-- [PLATZHALTER: Foto der Inhaber] Ein echtes Foto von Hussain und Ali wäre hier das stärkste Vertrauenszeichen -->
      <div class="vorstellung__bildbereich" data-einblenden>
        <Bild
          klasse="vorstellung__bild"
          bild={fotoWeg}
          format="4-3"
          formatGross="4-5"
          form="blatt"
          parallaxe
          sizes="(min-width: 80em) 36rem, (min-width: 64em) 46vw, 100vw"
          alt="Eine Begleiterin geht mit einer älteren Dame mit Gehstock die Straße entlang"
        />
      </div>
      <div class="vorstellung__text" data-einblenden="2">
        <p class="etikett">Über uns</p>
        <h2 id="vorstellung-titel">Jemand, der Zeit mitbringt.</h2>
        <p class="vorstellung__satz">
          Hinter {site.name} {site.mehrereInhaber ? 'stehen' : 'steht'} {site.inhaberin}. Bei uns haben Sie eine feste Ansprechperson,
          die Sie kennt, pünktlich kommt und gern zuhört.
        </p>
        <dl class="vorstellung__fakten">
          <div>
            <dt>{site.inhaberTitel}</dt>
            <dd>{site.inhaberin}</dd>
          </div>
          <div>
            <dt>Unterwegs in</dt>
            <dd>{site.einsatzorte.join(', ')}</dd>
          </div>
          <div>
            <dt>Erreichbar</dt>
            <dd>{site.erreichbarkeit}</dd>
          </div>
        </dl>
        {site.unterseiten && <a class="weiter" href={p('/ueber-uns/')}><span>Mehr über uns</span> <Symbol name="pfeil" /></a>}
      </div>
    </div>
  </section>
</Basis>

<style>
  /* Einstieg
     Text links über sieben Spalten, Foto rechts in Blattform bis an den Fensterrand.
     Dahinter eine Sandfläche als zweite Ebene, davor die Karte zur Pflegekasse. */
  .einstieg {
    position: relative;
    padding-block: var(--a-5) var(--a-bereich);
    overflow-x: clip;
  }
  .einstieg__raster {
    display: grid;
    gap: var(--a-6);
  }
  .einstieg h1 {
    margin-bottom: var(--a-4);
  }
  .einstieg__zeile {
    display: block;
  }
  .einstieg__zeile--gruen {
    color: var(--waldgruen);
  }
  .einstieg .einleitung {
    max-width: 30ch;
    margin-bottom: 0;
  }
  .einstieg__handeln {
    display: flex;
    flex-wrap: wrap;
    gap: var(--a-2);
    margin-top: var(--a-5);
  }
  @media (max-width: 29.99em) {
    .einstieg__handeln .knopf {
      flex: 1 1 100%;
    }
  }

  /* Drei Versprechen als ruhiges Band unter dem Einstieg: auf dem Handy untereinander, ab Tablet nebeneinander */
  .fakten {
    list-style: none;
    display: grid;
    gap: var(--a-2);
    margin: var(--a-7) auto 0;
    font-weight: 700;
    line-height: 1.35;
  }
  .fakten li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-top: var(--a-2);
    border-top: 1px solid var(--linie);
  }
  @media (min-width: 48em) {
    .fakten {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--spalt);
    }
    .fakten li {
      padding-top: var(--a-3);
    }
  }

  .einstieg__bildbereich {
    position: relative;
    isolation: isolate;
    /* Foto läuft rechts bis an den Fensterrand */
    margin-right: calc(-1 * var(--rand));
  }
  /* Zweite Ebene: Sandfläche in gleicher Form, nach links unten versetzt hinter dem Foto */
  .einstieg__bildbereich::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: var(--a-6);
    bottom: calc(-1 * var(--a-4));
    left: calc(-1 * var(--a-4));
    right: var(--a-6);
    border-radius: var(--r-blatt) var(--r-bild);
    background: var(--sand-tief) var(--korn);
  }
  .einstieg :global(.einstieg__bild .bild__rahmen) {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    box-shadow: var(--schatten-3);
  }

  /* Karte zur Pflegekasse, liegt über dem unteren Bildrand */
  .kassenkarte {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: var(--a-2);
    margin: calc(-1 * var(--a-5)) calc(var(--rand) + var(--a-2)) 0 var(--a-2);
    padding: var(--a-3);
    border-radius: var(--r-bild);
    background: var(--papier);
    box-shadow: inset 0 0 0 1px var(--linie-zart), var(--schatten-4);
    color: var(--tinte);
    text-decoration: none;
    transition: transform var(--uebergang), box-shadow var(--uebergang);
  }
  .kassenkarte:hover {
    color: var(--tinte);
    transform: translateY(-2px);
  }
  .kassenkarte:focus-visible {
    border-radius: var(--r-bild);
  }
  .kassenkarte__zeichen {
    display: grid;
    place-items: center;
    flex: none;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--waldgruen);
    color: var(--messing-hell);
    --blatt-ader: var(--waldgruen);
  }
  .kassenkarte__zeichen :global(.blatt) {
    width: 1.5rem;
    height: 1.5rem;
  }
  .kassenkarte__text {
    display: grid;
    gap: 0.2rem;
    line-height: 1.35;
  }
  .kassenkarte__text strong {
    font-family: var(--schrift-titel);
    font-size: var(--text-gross);
    font-weight: 560;
    color: var(--waldgruen);
  }
  .kassenkarte__text span {
    color: var(--leise);
  }
  .kassenkarte :global(.kassenkarte__pfeil) {
    margin-left: auto;
    width: 1.15rem;
    height: 1.15rem;
    color: var(--messing-text);
    transition: transform var(--uebergang);
  }
  .kassenkarte:hover :global(.kassenkarte__pfeil) {
    transform: translateX(4px);
  }
  @media (max-width: 29.99em) {
    .kassenkarte {
      align-items: flex-start;
      gap: 0.85rem;
      margin-inline: 0.75rem calc(var(--rand) + 0.75rem);
      padding: var(--a-2) 1.15rem;
    }
    .kassenkarte__zeichen {
      width: 2.5rem;
      height: 2.5rem;
    }
    .kassenkarte :global(.kassenkarte__pfeil) {
      align-self: center;
    }
  }

  /* Ab Tablet: zwei Spalten, Foto rechts im Hochformat */
  @media (min-width: 48em) {
    .einstieg {
      padding-top: var(--a-6);
    }
    .einstieg__raster {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 0 var(--spalt);
      align-items: start;
    }
    .einstieg__text {
      grid-column: 1 / span 7;
      grid-row: 1;
      padding-top: var(--a-4);
    }
    .einstieg__bildbereich {
      grid-column: 8 / -1;
      grid-row: 1;
    }
    /* Überschrift wächst mit der Spaltenbreite, damit jede Zeile in ihre Spalte passt */
    .einstieg h1 {
      font-size: min(var(--titel-1), max(2.75rem, 6vw));
    }
    .einstieg :global(.einstieg__bild .bild__rahmen) {
      aspect-ratio: 4 / 5;
    }
    .kassenkarte {
      margin: calc(-1 * var(--a-5)) calc(var(--rand) + var(--a-1)) 0 calc(-1 * var(--a-2));
      padding: var(--a-2) var(--a-3);
    }
  }
  @media (min-width: 48em) and (max-width: 63.99em) {
    .einstieg__handeln .knopf {
      flex: 1 1 100%;
    }
    .kassenkarte__zeichen {
      display: none;
    }
  }

  /* Desktop: Foto größer und quer, Karte ragt in die Textspalte */
  @media (min-width: 64em) {
    .einstieg {
      padding-top: var(--a-7);
    }
    .einstieg__text {
      padding-top: var(--a-5);
    }
    .einstieg h1 {
      font-size: min(var(--titel-1), 5.6vw);
    }
