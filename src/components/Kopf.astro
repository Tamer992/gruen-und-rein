---
import { p } from '../pfad';
import { site, navigation } from '../site.config';
import logo from './logo-mass.json';

const aktuell = Astro.url.pathname;
---
<header class="kopf">
  <a class="sprung" href="#inhalt">Zum Inhalt springen</a>
  <div class="behaelter kopf__zeile">
    <a class="kopf__marke" href={p('/')}>
      <img src={p('/logo.svg')} alt={`${site.name}, zur Startseite`} width={logo.breite} height={logo.hoehe} />
    </a>

    <p class="kopf__telefon">
      <span class="kopf__frage">Rufen Sie uns an</span>
      <a class="kopf__nummer" href={`tel:${site.telefonLink}`}>{site.telefon}</a>
      <span class="kopf__zeiten">{site.erreichbarkeit}</span>
    </p>

    <button class="kopf__menue" type="button" aria-expanded="false" aria-controls="hauptnavigation">
      <span class="kopf__menue-striche" aria-hidden="true"></span>
      <span class="kopf__menue-wort">Menü</span>
    </button>
  </div>

  <nav id="hauptnavigation" class="hauptnav" aria-label="Hauptnavigation">
    <ul class="behaelter hauptnav__liste">
      {navigation.map((punkt) => (
        <li>
          <a href={p(punkt.pfad)} aria-current={aktuell.startsWith(p(punkt.pfad)) ? 'page' : undefined}>{punkt.titel}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .kopf {
    border-bottom: 1px solid var(--linie);
    background: var(--papier);
  }
  .kopf__zeile {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'marke menue'
      'telefon telefon';
    align-items: center;
    gap: var(--a-2) var(--a-3);
    padding-block: var(--a-2);
  }
  .kopf__marke {
    grid-area: marke;
    display: inline-block;
    justify-self: start;
    padding-block: 0.25rem;
  }
  .kopf__marke img {
    width: clamp(11.5rem, 8rem + 12vw, 16.5rem);
  }

  .kopf__telefon {
    grid-area: telefon;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--a-2);
    padding-top: var(--a-2);
    border-top: 1px solid var(--linie);
  }
  .kopf__frage {
    font-size: var(--text-klein);
    color: var(--tinte-leise);
  }
  .kopf__nummer {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    padding-block: 0.35rem;
    max-width: 100%;
  }
  .kopf__zeiten {
    flex-basis: 100%;
    font-size: var(--text-klein);
    color: var(--tinte-leise);
  }

  .kopf__menue {
    grid-area: menue;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3rem;
    min-width: 3rem;
    padding: 0.5rem 1rem;
    font: inherit;
    font-weight: 700;
    color: var(--tanne);
    background: var(--papier);
    border: 2px solid var(--tanne);
    border-radius: var(--ecke);
    cursor: pointer;
  }
  .kopf__menue:hover {
    background: var(--blatt);
  }
  .kopf__menue-striche,
  .kopf__menue-striche::before,
  .kopf__menue-striche::after {
    display: block;
    width: 1.1rem;
    height: 2px;
    background: currentColor;
  }
  .kopf__menue-striche {
    position: relative;
  }
  .kopf__menue-striche::before,
  .kopf__menue-striche::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .kopf__menue-striche::before { top: -6px; }
  .kopf__menue-striche::after { top: 6px; }
  .kopf__menue[aria-expanded='true'] .kopf__menue-striche { background: transparent; }
  .kopf__menue[aria-expanded='true'] .kopf__menue-striche::before { top: 0; transform: rotate(45deg); }
  .kopf__menue[aria-expanded='true'] .kopf__menue-striche::after { top: 0; transform: rotate(-45deg); }

  /* Navigation: auf kleinen Bildschirmen aufklappbar */
  .hauptnav {
    display: none;
    border-top: 1px solid var(--linie);
  }
  .hauptnav.ist-offen {
    display: block;
  }
  .hauptnav__liste {
    list-style: none;
    margin: 0 auto;
    padding-block: var(--a-1) var(--a-2);
  }
  .hauptnav__liste li {
    border-bottom: 1px solid var(--linie);
  }
  .hauptnav__liste li:last-child {
    border-bottom: 0;
  }
  .hauptnav a {
    display: flex;
    align-items: center;
    min-height: 3.25rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--tinte);
  }
  .hauptnav a:hover {
    color: var(--tanne);
    text-decoration: underline;
  }
  .hauptnav a[aria-current='page'] {
    color: var(--tanne);
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.35em;
  }

  /* Ab Tablet: Telefon neben der Wortmarke. Wird es eng (große Schrift), rutscht es darunter. */
  @media (min-width: 40em) {
    .kopf__zeile {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      padding-block: var(--a-3);
    }
    .kopf__marke {
      flex: none;
      margin-right: auto;
    }
    .kopf__telefon {
      order: 2;
      flex: 0 1 auto;
      justify-content: flex-end;
      text-align: right;
      border-top: 0;
      padding-top: 0;
    }
    .kopf__menue {
      order: 3;
    }
  }

  /* Ab Desktop: Navigation immer sichtbar, kein Menü-Knopf */
  @media (min-width: 60em) {
    .kopf__zeile {
      padding-block: var(--a-4) var(--a-3);
    }
    .kopf__menue {
      display: none;
    }
    .kopf__nummer {
      font-size: 1.75rem;
    }
    .hauptnav,
    .hauptnav.ist-offen {
      display: block;
    }
    .hauptnav__liste {
      display: flex;
      flex-wrap: wrap;
      gap: 0 clamp(1.25rem, 2.6vw, 2.75rem);
      padding-block: 0;
    }
    .hauptnav__liste li {
      border-bottom: 0;
    }
    .hauptnav a {
      min-height: 3.5rem;
    }
  }
</style>
