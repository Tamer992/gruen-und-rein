---
import Leistungsseite from '../components/Leistungsseite.astro';
import { site } from '../site.config';
import fotoKopf from '../bilder/alltag-park.jpg';
import fotoMitte from '../bilder/alltag-gesellschaft.jpg';

const fragen = [
  {
    frage: 'Wie oft können Sie kommen?',
    antwort:
      'So oft, wie es zu Ihnen passt. Manche wünschen sich einen festen Nachmittag in der Woche, andere zwei oder drei Termine. Das besprechen wir beim ersten Besuch.',
  },
  {
    frage: 'Kommt immer dieselbe Person?',
    antwort:
      'Ja, Sie haben bei uns eine feste Ansprechperson. Ist sie einmal im Urlaub, sagen wir Ihnen vorher Bescheid, wer stattdessen kommt.',
  },
  {
    frage: 'Gehört Pflege auch dazu?',
    antwort:
      'Alltagsbegleitung ergänzt die Pflege. Körperpflege und die Gabe von Medikamenten übernimmt ein Pflegedienst. Rezepte und Medikamente holen wir gern für Sie ab, und wir kümmern uns um alles, was den Tag schön und leichter macht.',
  },
  {
    frage: 'Können meine Angehörigen beim Kennenlernen dabei sein?',
    antwort:
      'Sehr gern. Ihre Kinder können auch per Telefon dazukommen. Auf Wunsch geben wir ihnen nach jedem Besuch kurz Bescheid.',
  },
  ...(site.pflegekasse
    ? [
        {
          frage: 'Übernimmt die Pflegekasse die Alltagsbegleitung?',
          // [ERGÄNZEN: Abrechnung offen, ob Grün & Rein direkt mit der Pflegekasse abrechnet. Bis zur Klärung neutral formuliert. Frühere Fassung: „… Wir rechnen direkt mit Ihrer Pflegekasse ab.“]
          antwort:
            'Ja. Mit einem Pflegegrad setzen Sie dafür Ihren monatlichen Entlastungsbetrag ein. Wie die Abrechnung läuft, besprechen wir gern mit Ihnen.',
          link: { text: 'So funktioniert es mit der Pflegekasse', pfad: '/pflegekasse/' },
        },
      ]
    : []),
];
---
<Leistungsseite
  anker="alltagsbegleitung"
  titel={`Alltagsbegleitung und Betreuung in ${site.ort} | ${site.name}`}
  beschreibung={`Begleitung und Betreuung im Alltag, auch bei Demenz: Spaziergänge, Gespräche, Begleitung zum Arzt, Rezepte, Post und Behördengänge. Für Erwachsene und Kinder in ${site.ort} und Umgebung, mit Pflegegrad über die Pflegekasse.`}
  ueberschrift="Jemand, der mitgeht."
  einleitung="Wir begleiten und unterstützen Menschen im Alltag, auch Menschen mit Demenz. Wir gehen mit Ihnen spazieren, einkaufen oder zum Arzt, trinken Kaffee und spielen Karten. Ganz so, wie es Ihnen Freude macht."
  bild={fotoKopf}
  alt="Zwei Frauen gehen untergehakt und lachend durch einen Park"
  ausschnitt="oben"
  aufgabenTitel="Was wir gemeinsam unternehmen"
  aufgaben={[
    { titel: 'Begleitung im Alltag', text: 'Wir sind an Ihrer Seite, im Haus und unterwegs. Bei Spaziergängen um den Block oder durch den Park, in Ihrem Tempo und mit einem sicheren Arm.' },
    { titel: 'Unterstützung bei alltäglichen Aktivitäten', text: 'Wir packen bei den Dingen des Tages mit an, damit Sie so selbstständig bleiben, wie Sie es gewohnt sind.' },
    { titel: 'Gespräche und gemeinsame Beschäftigung', text: 'Zeit für ein Gespräch, ein Kartenspiel, ein Rätsel oder einen Blick ins Fotoalbum. Bei einer Tasse Kaffee, in Ruhe.' },
    { titel: 'Betreuung bei Demenz', text: 'Wir begleiten Menschen mit Demenz mit Geduld, festen Abläufen und einem vertrauten Gesicht. Mit Beschäftigung, die an Vertrautes anknüpft und Freude macht.' },
    { titel: 'Für Erwachsene und Kinder', text: 'Unsere Betreuung richtet sich nach dem Menschen. Wir begleiten Erwachsene ebenso wie Kinder, ganz individuell.' },
    { titel: 'Einfühlsam und respektvoll', text: 'Wir begegnen Ihnen und Ihren Angehörigen mit Respekt und Einfühlungsvermögen. Ihre Wünsche und Gewohnheiten geben den Ton an.' },
    { titel: 'Einkäufe', text: 'Wir gehen mit Ihnen einkaufen oder erledigen den Einkauf nach Ihrer Liste und räumen alles ein.' },
    { titel: 'Begleitung zum Arzt', text: 'Wir gehen mit in die Praxis, warten mit im Wartezimmer und schreiben auf Wunsch mit, was besprochen wurde.' },
    { titel: 'Rezepte und Medikamente', text: 'Wir bestellen Ihre Rezepte in der Praxis, holen sie ab und bringen die Medikamente aus der Apotheke zu Ihnen nach Hause.' },
    { titel: 'Post und Termine', text: 'Wir lesen gemeinsam Ihre Briefe, helfen beim Ausfüllen von Formularen und behalten Ihre Termine im Blick.' },
    { titel: 'Wege und Behördengänge', text: 'Zur Bank, zum Amt, zur Post oder zum Friseur. Wir gehen mit oder übernehmen den Weg für Sie.' },
    { titel: 'Entlastung für Angehörige', text: 'Sie haben ein paar Stunden für sich und wissen Ihre Mutter, Ihren Vater oder Ihr Kind in guter Gesellschaft.' },
  ]}
  mitte={{
    titel: 'Ein Besuch, auf den man sich freut.',
    absaetze: [
      'Zu Ihnen kommt immer dieselbe Person. Sie kennt Ihre Gewohnheiten, weiß, wie Sie Ihren Kaffee trinken, und hört zu, wenn Sie etwas auf dem Herzen haben.',
      'Angehörige halten wir auf dem Laufenden, wenn Sie das möchten. Ein kurzer Anruf nach dem Besuch, und alle wissen, dass es Ihnen gut geht.',
    ],
    bild: fotoMitte,
    alt: 'Eine Begleiterin und eine ältere Dame sitzen nah beieinander und lachen',
    ausschnitt: 'rechts',
  }}
  fragen={fragen}
/>
