---
// Ersatz für Anruf- und WhatsApp-Knöpfe am Computer mit Maus (Klasse nur-maus, siehe global.css):
// Dort kann man meist nicht anrufen, also die Nummer als ruhiger Text zum Abschreiben,
// auf Wunsch mit QR-Code zum Anrufen mit dem Handy (Tamer, 04.10.2026).
// „hell“ für dunkle Flächen (Tanne).
import { site } from '../site.config';
import QrCode from './QrCode.astro';

interface Props {
  hell?: boolean;
  qr?: boolean;
  klasse?: string;
}
const { hell = false, qr = false, klasse } = Astro.props;
---
<div class:list={['anrufhinweis', 'nur-maus', { 'anrufhinweis--hell': hell, 'anrufhinweis--qr': qr }, klasse]}>
  {qr && (
    <QrCode klasse="anrufhinweis__qr" inhalt={`tel:${site.telefonLink}`} beschriftung={`QR-Code: ${site.telefon} anrufen`} />
  )}
  <div class="anrufhinweis__text">
    <span class="anrufhinweis__art">Rufen Sie uns an</span>
    <a class="anrufhinweis__nummer nummer" href={`tel:${site.telefonLink}`}>{site.telefon}</a>
    <span class="anrufhinweis__zeit">
      {qr ? 'Code mit dem Handy scannen und anrufen' : site.erreichbarkeit}
    </span>
  </div>
</div>

<style>
  .anrufhinweis {
    display: flex;
    align-items: center;
    gap: var(--a-3);
  }
  .anrufhinweis__text {
    display: grid;
    gap: 0.1rem;
  }
  .anrufhinweis__art {
    font-weight: 700;
    color: var(--tinte);
  }
  .anrufhinweis__nummer {
    font-size: clamp(1.6rem, 1.3rem + 0.9vw, 2.1rem);
    line-height: 1.2;
    color: var(--waldgruen);
    text-decoration: none;
  }
  .anrufhinweis__zeit {
    font-size: var(--text-klein);
    color: var(--leise);
  }
  .anrufhinweis :global(.anrufhinweis__qr) {
    flex: none;
    width: 5.5rem;
    padding: 0.45rem;
    border-radius: 0.6rem;
    background: var(--papier);
    box-shadow: inset 0 0 0 1px var(--linie);
  }

  /* Auf Tanne */
  .anrufhinweis--hell .anrufhinweis__art {
    color: var(--hell);
  }
  .anrufhinweis--hell .anrufhinweis__nummer {
    color: var(--messing-hell);
  }
  .anrufhinweis--hell .anrufhinweis__zeit {
    color: var(--auf-tanne);
  }
  .anrufhinweis--hell :global(.anrufhinweis__qr) {
    box-shadow: none;
  }
</style>
