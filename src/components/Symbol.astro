---
// Symbole aus Phosphor Icons (MIT-Lizenz), feine Linienform, direkt ins HTML eingesetzt.
// Rein dekorativ: Die Beschriftung steht immer daneben.
// „kreis“ setzt das Symbol in einen dezenten Kreis (für Knöpfe).
import telefon from '@phosphor-icons/core/assets/regular/phone.svg?raw';
import whatsapp from '@phosphor-icons/core/assets/regular/whatsapp-logo.svg?raw';
import uhr from '@phosphor-icons/core/assets/regular/clock.svg?raw';
import ort from '@phosphor-icons/core/assets/regular/map-pin.svg?raw';
import pfeil from '@phosphor-icons/core/assets/bold/arrow-right-bold.svg?raw';
import haken from '@phosphor-icons/core/assets/bold/check-bold.svg?raw';
import brief from '@phosphor-icons/core/assets/regular/envelope-simple.svg?raw';

const symbole = { telefon, whatsapp, pfeil, haken, uhr, ort, brief };
interface Props {
  name: keyof typeof symbole;
  kreis?: boolean;
  klasse?: string;
}
const { name, kreis = false, klasse } = Astro.props;
const svg = symbole[name].replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
---
<span class:list={['symbol', { 'symbol--kreis': kreis }, klasse]} set:html={svg} />
